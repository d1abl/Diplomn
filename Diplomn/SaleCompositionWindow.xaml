<Window x:Class="Diplomn.SaleCompositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав продажи" Height="450" Width="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Состав чека" HorizontalAlignment="Center"/>

        <DataGrid x:Name="DataGridItems" Grid.Row="1" AutoGenerateColumns="False" Margin="0,20" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код товара" Binding="{Binding Код_товара}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding Товар}" Width="250" IsReadOnly="True"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Количество, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Цена, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2} }" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} }" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🗑 Удалить" Width="100" Height="35" Margin="5" Click="DeleteSelected_Click"/>
            <Button Content="💾 Сохранить" Width="100" Height="35" Margin="5" Click="Save_Click"/>
            <Button Content="✖ Отмена" Width="100" Height="35" Margin="5" Click="Cancel_Click"/>
            <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock x:Name="TxtTotal" FontSize="18" FontWeight="Bold" Foreground="#F44336" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>