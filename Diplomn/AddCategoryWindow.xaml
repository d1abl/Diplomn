<Window x:Class="Diplomn.AddCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категория" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Новая категория" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,20">
            <TextBlock Text="Наименование категории:" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtName" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtDescription" 
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="110"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button Content="Сохранить" Click="Save_Click"/>
            <Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>