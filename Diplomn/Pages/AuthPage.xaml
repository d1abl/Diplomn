<Page x:Class="Diplomn.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="Авторизация"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Карточка авторизации -->
        <Border Grid.Row="1" 
                Padding="40" 
                CornerRadius="8"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="380">

            <StackPanel>
                <!-- Логотип / Название -->
                <TextBlock Text="Oculus+" 
                           FontSize="38" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <!-- Подзаголовок -->
                <TextBlock Text="Вход в систему" 
                           FontSize="19"
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"
                           Opacity="0.8"/>

                <!-- Поле: Логин -->
                <TextBlock Text="Логин" 
                           FontSize="19" 
                           Margin="0,0,0,5" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBox x:Name="LoginBox"  Text="admin"
                         Height="38" 
                         Margin="0,0,0,15" Foreground="{DynamicResource ForegroundBrush}"
                         FontSize="18"
                         addons:PlaceholderBehavior.PlaceholderText="Введите логин"/>

                <!-- Поле: Пароль -->
                <TextBlock Text="Пароль" 
                           FontSize="19" 
                           Margin="0,0,0,5" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <PasswordBox x:Name="PassBox" Password="admin123"
                             Height="38" 
                             Margin="0,0,0,25" Foreground="{DynamicResource ForegroundBrush}"
                             FontSize="20"
                             addons:PlaceholderBehavior.HasEye="True"
                             addons:PlaceholderBehavior.PlaceholderText="Введите пароль"/>

                <!-- Кнопки действий -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            x:Name="LoginBtn" 
                            Content="Войти" 
                            Click="LoginBtn_Click" 
                            Height="40" 
                            Margin="0,0,5,0"
                            Background="{DynamicResource BackgroundBrush}" 
                            FontWeight="Bold"
                            FontSize="14"/>

                    <Button Grid.Column="1" 
                            x:Name="ExitBtn" 
                            Content="Выход" 
                            Click="ExitBtn_Click" 
                            Height="40" 
                            Margin="5,0,0,0"
                            FontSize="14"/>
                </Grid>

                <!-- Сообщение об ошибке -->
                <Border x:Name="ErrorBorder" 
                        Background="{DynamicResource DangerBrush}" 
                        CornerRadius="4" 
                        Padding="12,10" 
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" 
                               Foreground="White" 
                               HorizontalAlignment="Center" 
                               TextWrapping="Wrap"
                               FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>