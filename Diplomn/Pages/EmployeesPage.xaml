<Page x:Class="Diplomn.Pages.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="EmployeesPage">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление сотрудниками" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: карточки сотрудников -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск и кнопки -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по фамилии или логину (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по фамилии или логину"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Карточки сотрудников -->
                <ListView Grid.Row="1" x:Name="ListViewEmployees"
                          SelectionMode="Single"
                          SelectionChanged="ListViewEmployees_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="5"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" 
                                    Width="250"
                                    Height="200"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="60" Height="60" CornerRadius="30"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding AvatarSource}" 
                                                   Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" 
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="150"/>
                                            <TextBlock Text="{Binding Position}" 
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{Binding LoginDisplay}" 
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Телефон, Converter={StaticResource PhoneNumberConverter}}" 
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AccessLevelDisplay}" 
                                                   FontSize="11"
                                                   Margin="0,5,0,0"
                                                   Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование сотрудника" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <Border Width="120" Height="120" CornerRadius="60"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="EmployeePhoto" Source="/Photos/istockavatar.png" Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <TextBlock Text="Нажмите для изменения фото" FontSize="10" 
                              HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,15"/>

                    <TextBlock Text="Код" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtEmployeeId" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Код сотрудника"/>

                    <TextBlock Text="Фамилия *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLastName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите фамилию"/>

                    <TextBlock Text="Имя *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtFirstName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите имя"/>

                    <TextBlock Text="Отчество" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtMiddleName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите отчество"/>

                    <TextBlock Text="Телефон" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPhone" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="79009001122"/>

                    <TextBlock Text="Должность *" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbPosition" Height="32" Margin="0,0,0,10"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите должность"
                              DisplayMemberPath="Название" SelectedValuePath="Код_должности"/>

                    <TextBlock Text="Логин *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLogin" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите логин"/>

                    <TextBlock Text="Пароль" FontSize="11" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="PassBox" Height="30" Margin="0,0,0,10"
                                addons:PlaceholderBehavior.HasEye="True"
                                addons:PlaceholderBehavior.PlaceholderText="Введите пароль"/>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Добавить" Click="Add_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Обновить" Click="Update_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Удалить" Click="Delete_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Очистить" Click="ClearForm_Click" Width="90" Height="35" Margin="3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>