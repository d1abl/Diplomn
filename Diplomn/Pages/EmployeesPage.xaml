<Page x:Class="Diplomn.Pages.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="Сотрудники"
      Background="{DynamicResource BackgroundBrush}">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Управление сотрудниками" FontSize="13" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: карточки сотрудников -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска -->
                <Border Grid.Row="0" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по фамилии или логину..."
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                            <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                            <Button Content="📊" Width="36" Height="32" Click="SaveReport_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Карточки сотрудников -->
                <ListView Grid.Row="1" x:Name="ListViewEmployees"
                          SelectionMode="Single"
                          SelectionChanged="ListViewEmployees_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="5"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Width="345" Height="140"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Верх: аватар + ФИО -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="60" Height="60" CornerRadius="30"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1" Margin="0,0,10,0">
                                            <Image Source="{Binding AvatarSource}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="14"
                                                       TextWrapping="Wrap" MaxWidth="250"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Text="{Binding Position}" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Низ: детали -->
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{Binding LoginDisplay}" FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding Телефон, Converter={StaticResource PhoneNumberConverter}}" 
                                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding AccessLevelDisplay}" FontSize="11" 
                                                   Margin="0,5,0,0" Opacity="0.7"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" 
                    Opacity="0.2" Margin="15,0"/>

            <!-- Правая панель: форма редактирования -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование сотрудника" 
                               FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Фото -->
                    <Border Width="120" Height="120" CornerRadius="60"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="EmployeePhoto" Source="/Photos/istockavatar.png" Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <TextBlock Text="Нажмите для изменения фото" FontSize="10" 
                               HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,15"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Код -->
                    <TextBlock Text="Код" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmployeeId" IsReadOnly="True" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Код сотрудника"/>

                    <!-- Фамилия -->
                    <TextBlock Text="Фамилия *" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLastName" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Введите фамилию"/>

                    <!-- Имя -->
                    <TextBlock Text="Имя *" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFirstName" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Введите имя"/>

                    <!-- Отчество -->
                    <TextBlock Text="Отчество" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMiddleName" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Введите отчество"/>

                    <!-- Телефон -->
                    <TextBlock Text="Телефон" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="79001234567"/>

                    <!-- Должность -->
                    <TextBlock Text="Должность *" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPosition" Height="34" Margin="0,0,0,12"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите должность"
                              DisplayMemberPath="Название" 
                              SelectedValuePath="Код_должности"/>

                    <!-- Логин -->
                    <TextBlock Text="Логин *" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLogin" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Введите логин"/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль" FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PassBox" Height="32" Margin="0,0,0,15"
                                addons:PlaceholderBehavior.HasEye="True"
                                addons:PlaceholderBehavior.PlaceholderText="Введите пароль"/>

                    <!-- Кнопки действий -->
                    <WrapPanel x:Name="ActionButtonsPanel" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>