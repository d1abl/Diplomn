<Page x:Class="Diplomn.Pages.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplomn.Pages"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d" 
      Title="EmployeesPage">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="WelcomeText" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Управление сотрудниками" FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: таблица сотрудников -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Список сотрудников" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <DataGrid x:Name="DataGridEmployees" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="300" 
                          Margin="0,5,0,0"
                          SelectionChanged="DataGridEmployees_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фамилия" Binding="{Binding Фамилия}" Width="100"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Имя}" Width="80"/>
                        <DataGridTextColumn Header="Отчество" Binding="{Binding Отчество}" Width="100"/>
                        <DataGridTextColumn Header="Телефон">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Телефон" Converter="{StaticResource PhoneNumberConverter}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Должность" Binding="{Binding Должность.Название}" Width="120"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Логин}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="1" Width="2" Background="#E0E0E0" Margin="10,0"/>

            <!-- Правая панель: форма редактирования -->
            <ScrollViewer Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование сотрудника" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                    <!-- Фото сотрудника с возможностью изменения -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="2" 
                            Width="120" Height="120" CornerRadius="60"
                            Margin="10" HorizontalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="EmployeePhoto" 
                               Source="/Photos/istockavatar.png"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <TextBlock Text="Нажмите на фото для изменения" 
                              FontSize="10" Foreground="Gray" 
                              HorizontalAlignment="Center" Margin="0,5,0,10"/>

                    <TextBlock Text="Код:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtEmployeeId" IsReadOnly="True" Background="#F0F0F0" Height="30"/>

                    <TextBlock Text="Фамилия:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtLastName" Height="30"/>

                    <TextBlock Text="Имя:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtFirstName" Height="30"/>

                    <TextBlock Text="Отчество:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtMiddleName" Height="30"/>

                    <TextBlock Text="Телефон:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtPhone" Height="30"/>

                    <TextBlock Text="Должность:" Margin="0,10,0,5"/>
                    <ComboBox x:Name="CmbPosition" Height="35" DisplayMemberPath="Название" SelectedValuePath="Код_должности"/>

                    <TextBlock Text="Логин:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtLogin" Height="30"/>

                    <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
                    <PasswordBox x:Name="PassBox" Height="30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="➕ Добавить" Click="Add_Click" Width="100" Margin="5"/>
                        <Button Content="💾 Обновить" Click="Update_Click" Width="100" Margin="5"/>
                        <Button Content="🗑 Удалить" Click="Delete_Click" Width="100" Margin="5"/>
                        <Button Content="❌ Очистить" Click="ClearForm_Click" Width="100" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="🔄 Обновить таблицу" Click="Refresh_Click" Width="150" Margin="5"/>
        </StackPanel>-->
    </Grid>
</Page>