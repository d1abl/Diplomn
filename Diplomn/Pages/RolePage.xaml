<Page x:Class="Diplomn.Pages.RolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplomn.Pages"
      mc:Ignorable="d" 
      Title="RolePage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление ролями (должностями)"/>

        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Список ролей" FontWeight="Bold" FontSize="14"/>
                <DataGrid x:Name="DataGridRoles" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="300" Margin="0,5,0,0"
                          SelectionChanged="DataGridRoles_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_должности}"/>
                        <DataGridTextColumn Header="Название роли" Binding="{Binding Название}"/>
                        <DataGridTextColumn Header="Уровень доступа" Binding="{Binding Уровень_доступа}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="1" Width="2" Background="#E0E0E0" Margin="10,0"/>

            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Редактирование роли" FontWeight="Bold" FontSize="14"/>

                <TextBlock Text="Код:" Margin="0,10,0,5"/>
                <TextBox x:Name="TxtRoleId" IsReadOnly="True" Background="#F0F0F0"/>

                <TextBlock Text="Название роли:" Margin="0,10,0,5"/>
                <TextBox x:Name="TxtRoleName"/>

                <TextBlock Text="Уровень доступа (1-10):" Margin="0,10,0,5"/>
                <TextBox x:Name="TxtAccessLevel"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="➕ Добавить" Click="AddRole_Click" />
                    <Button Content="💾 Обновить" Click="UpdateRole_Click"/>
                    <Button Content="🗑 Удалить" Click="DeleteRole_Click" />
                    <Button Content="❌ Очистить" Click="ClearForm_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Уровень доступа: 1 - администратор, 10 - самый низкий" 
                   Foreground="Gray" FontSize="12" TextAlignment="Center"/>
    </Grid>
</Page>
