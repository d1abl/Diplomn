<Page x:Class="Diplomn.Pages.RolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RolePage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Должности" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление ролями и уровнями доступа" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по названию должности (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица -->
                <DataGrid Grid.Row="1" x:Name="DataGridRoles" 
                          SelectionChanged="DataGridRoles_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_должности}" Width="60"/>
                        <DataGridTextColumn Header="Название должности" Binding="{Binding Название}" Width="180"/>
                        <DataGridTextColumn Header="Уровень доступа" Binding="{Binding Уровень_доступа}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="15,0"/>

            <!-- Правая панель -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Редактирование должности" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                <TextBlock Text="Код" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtRoleId" IsReadOnly="True" Height="30" Margin="0,0,0,15"/>

                <TextBlock Text="Название должности *" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtRoleName" Height="30" Margin="0,0,0,15"/>

                <TextBlock Text="Уровень доступа (1-10)" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtAccessLevel" Height="30" Margin="0,0,0,15"/>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Уровни доступа:" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,3">• 1 - Администратор (полный доступ)</TextBlock>
                        <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,3">• 2-3 - Управляющий персонал</TextBlock>
                        <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,3">• 4-6 - Менеджеры</TextBlock>
                        <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,3">• 7-10 - Младший персонал</TextBlock>
                    </StackPanel>
                </Border>

                <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Добавить" Click="AddRole_Click" Width="90" Height="35" Margin="3"/>
                    <Button Content="Обновить" Click="UpdateRole_Click" Width="90" Height="35" Margin="3"/>
                    <Button Content="Удалить" Click="DeleteRole_Click" Width="90" Height="35" Margin="3"/>
                    <Button Content="Очистить" Click="ClearForm_Click" Width="90" Height="35" Margin="3"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>