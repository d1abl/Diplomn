<Page x:Class="Diplomn.Pages.RolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="Должности"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Должности" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Управление ролями и уровнями доступа" FontSize="13" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по названию..."
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                            <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" x:Name="DataGridRoles"
                          SelectionChanged="DataGridRoles_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_должности}" Width="60"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Название}" Width="180"/>
                        <DataGridTextColumn Header="Уровень доступа" Binding="{Binding Уровень_доступа}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" 
                    Opacity="0.2" Margin="15,0"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Редактирование должности" FontWeight="Bold" FontSize="14" 
                           Margin="0,0,0,15" Foreground="{DynamicResource ForegroundBrush}"/>

                <TextBlock Text="Код" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtRoleId" IsReadOnly="True" Height="32" Margin="0,0,0,12"
                         addons:PlaceholderBehavior.PlaceholderText="Код должности"/>

                <TextBlock Text="Название *" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtRoleName" Height="32" Margin="0,0,0,12"
                         addons:PlaceholderBehavior.PlaceholderText="Введите название"/>

                <TextBlock Text="Уровень доступа (1-10)" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAccessLevel" Height="32" Margin="0,0,0,15"
                         addons:PlaceholderBehavior.PlaceholderText="Введите уровень доступа"/>

                <!-- Подсказка по уровням -->
                <Border Padding="10" CornerRadius="4" Margin="0,0,0,15"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource BackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Уровни доступа:" FontWeight="Bold" FontSize="12" 
                                   Margin="0,0,0,6" Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,2"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            • 1 — Администратор<LineBreak/>
                            • 2-3 — Менеджер<LineBreak/>
                            • 4-10 — Сотрудник
                        </TextBlock>
                    </StackPanel>
                </Border>

                <WrapPanel x:Name="ActionButtonsPanel" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>