<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Diplomn.Pages.SuppliersPage"
      Title="Поставщики"
      Background="{DynamicResource BackgroundBrush}">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" Text="Поставщики" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Управление поставщиками" FontSize="16" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: карточки -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" FontSize="19"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию или ИНН..."
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                            <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                            <Button Content="📊" Width="36" Height="32" Click="SaveReport_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListView Grid.Row="1" x:Name="ListViewSuppliers" SelectionMode="Single"
                          SelectionChanged="ListViewSuppliers_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="0 5 0 0"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0" Width="340" Height="120"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="0 10 0 0" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}, Mode=FindAncestor}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="4" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding LogoSource}" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Наименование_поставщика}" FontWeight="Bold" FontSize="20"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding ИНН}" Margin="0,4,0,0" FontSize="18" Opacity="0.7"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding ContactPersonDisplay}" Margin="0,4,0,0" FontSize="17"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding PhoneDisplay, Converter={StaticResource PhoneNumberConverter}}" 
                                                   FontSize="16" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Opacity="0.2" Margin="15,0"/>

            <!-- Правая панель: форма -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование поставщика" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <Border Width="100" Height="100" CornerRadius="8"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectLogo_Click">
                        <Image x:Name="SupplierLogo" Source="/Photos/istocklogo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Нажмите для изменения логотипа" FontSize="14" 
                               HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,15"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <TextBlock Text="Код" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSupplierId" IsReadOnly="True" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Код поставщика" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                    <TextBlock Text="Наименование *" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSupplierName" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите наименование"/>

                    <TextBlock Text="ИНН *" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInn" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите ИНН"/>

                    <TextBlock Text="Адрес *" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAddress" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите адрес"/>

                    <TextBlock Text="Email *" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="email@example.com"/>

                    <TextBlock Text="Фамилия контактного лица *" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtContactLastName" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите фамилию"/>

                    <TextBlock Text="Имя контактного лица *" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtContactFirstName" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите имя"/>

                    <TextBlock Text="Отчество" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtContactMiddleName" Height="32" Margin="0,0,0,12" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите отчество"/>

                    <TextBlock Text="Телефон" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="32" Margin="0,0,0,15" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="79001234567"/>

                    <WrapPanel x:Name="ActionButtonsPanel" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <Border x:Name="SuccessBorder" 
        Background="{DynamicResource SuccessBrush}" 
        CornerRadius="4" 
        Padding="12,10" 
        Margin="0,15,0,0"
        Visibility="Collapsed">
                        <TextBlock x:Name="SuccessText" 
               Foreground="{DynamicResource ForegroundBrush}" 
               HorizontalAlignment="Center" 
               TextWrapping="Wrap"
               FontSize="13"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>