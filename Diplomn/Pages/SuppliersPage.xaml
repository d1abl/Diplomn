<Page x:Class="Diplomn.Pages.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="SuppliersPage">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" Text="Поставщики" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление поставщиками" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: карточки поставщиков -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по наименованию или ИНН (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию или ИНН"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Карточки поставщиков -->
                <ListView Grid.Row="1" x:Name="ListViewSuppliers"
                          SelectionMode="Single"
                          SelectionChanged="ListViewSuppliers_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="5"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" 
                                    Width="250"
                                    Height="180"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Логотип -->
                                    <Border Grid.Column="0" Width="70" Height="70" 
                                            CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,0,10,0">
                                        <Image Source="{Binding LogoSource}" 
                                               Stretch="Uniform"/>
                                    </Border>

                                    <!-- Информация -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Наименование_поставщика}" 
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Наименование_поставщика}"
                                                   TextWrapping="NoWrap"/>

                                        <TextBlock Text="{Binding ИНН}" 
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BorderBrush}"/>

                                        <TextBlock Text="{Binding ContactPersonDisplay}" 
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding PhoneDisplay, Converter={StaticResource PhoneNumberConverter}}" 
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование поставщика" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <Border Width="120" Height="120" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectLogo_Click">
                        <Image x:Name="SupplierLogo" Source="/Photos/istocklogo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Нажмите для изменения логотипа" FontSize="10" 
                              HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,15"/>

                    <TextBlock Text="Код" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSupplierId" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Код поставщика"/>

                    <TextBlock Text="Наименование *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSupplierName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите наименование"/>

                    <TextBlock Text="ИНН *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtInn" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите ИНН"/>

                    <TextBlock Text="Адрес *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtAddress" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите адрес"/>

                    <TextBlock Text="Email *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtEmail" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="email@example.com"/>

                    <TextBlock Text="Фамилия контактного лица *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtContactLastName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите фамилию"/>

                    <TextBlock Text="Имя контактного лица *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtContactFirstName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите имя"/>

                    <TextBlock Text="Отчество контактного лица" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtContactMiddleName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите отчество"/>

                    <TextBlock Text="Телефон" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPhone" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="+7 (___) ___-__-__"/>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Добавить" Click="Add_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Обновить" Click="Update_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Удалить" Click="Delete_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Очистить" Click="ClearForm_Click" Width="90" Height="35" Margin="3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>