<Page x:Class="Diplomn.Pages.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="SuppliersPage">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Поставщики" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление поставщиками" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по наименованию или ИНН (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица -->
                <DataGrid Grid.Row="1" x:Name="DataGridSuppliers" 
                          SelectionChanged="DataGridSuppliers_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_поставщика}" Width="60"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование_поставщика}" Width="160"/>
                        <DataGridTextColumn Header="ИНН" Binding="{Binding ИНН}" Width="100"/>
                        <DataGridTextColumn Header="Контактное лицо" Binding="{Binding Фамилия_контактного_лица}" Width="120"/>
                        <DataGridTextColumn Header="Телефон" Width="120">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Телефон_контактного_лица" Converter="{StaticResource PhoneNumberConverter}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование поставщика" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <Border Width="120" Height="120" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectLogo_Click">
                        <Image x:Name="SupplierLogo" Source="/Photos/istocklogo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Нажмите для изменения логотипа" FontSize="10" 
                              HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,15"/>

                    <TextBlock Text="Код" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSupplierId" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Наименование *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSupplierName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="ИНН *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtInn" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Адрес *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtAddress" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Email *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtEmail" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Фамилия контактного лица *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtContactLastName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Имя контактного лица *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtContactFirstName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Отчество контактного лица" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtContactMiddleName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Телефон" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPhone" Height="30" Margin="0,0,0,10"/>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Добавить" Click="Add_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Обновить" Click="Update_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Удалить" Click="Delete_Click" Width="90" Height="35" Margin="3"/>
                        <Button Content="Очистить" Click="ClearForm_Click" Width="90" Height="35" Margin="3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>