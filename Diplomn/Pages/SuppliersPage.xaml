<Page x:Class="Diplomn.Pages.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplomn.Pages"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d" 
      Title="SuppliersPage">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление поставщиками" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: таблица поставщиков -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Список поставщиков" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <DataGrid x:Name="DataGridSuppliers" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="300" 
                          Margin="0,5,0,0"
                          SelectionChanged="DataGridSuppliers_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_поставщика}" Width="60"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование_поставщика}" Width="180"/>
                        <DataGridTextColumn Header="ИНН" Binding="{Binding ИНН}" Width="120"/>
                        <DataGridTextColumn Header="Контактное лицо" Binding="{Binding Фамилия_контактного_лица}" Width="130"/>
                        <DataGridTextColumn Header="Телефон">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Телефон_контактного_лица" Converter="{StaticResource PhoneNumberConverter}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="1" Width="2" Background="#E0E0E0" Margin="10,0"/>

            <!-- Правая панель: форма редактирования -->
            <ScrollViewer Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование поставщика" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                    <Border BorderBrush="#E0E0E0" BorderThickness="2" 
                            Width="120" Height="120" CornerRadius="10"
                            Margin="10" HorizontalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonDown="SelectLogo_Click">
                        <Image x:Name="SupplierLogo" 
                               Source="/Photos/istocklogo.png"
                               Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Нажмите на логотип для изменения" 
                               FontSize="10" Foreground="Gray" 
                               HorizontalAlignment="Center" Margin="0,5,0,10"/>

                    <TextBlock Text="Код:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtSupplierId" IsReadOnly="True" Background="#F0F0F0" Height="30"/>

                    <TextBlock Text="Наименование:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtSupplierName" Height="30"/>

                    <TextBlock Text="ИНН:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtInn" Height="30"/>

                    <TextBlock Text="Адрес:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtAddress" Height="30"/>

                    <TextBlock Text="Email:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtEmail" Height="30"/>

                    <TextBlock Text="Фамилия контактного лица:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtContactLastName" Height="30"/>

                    <TextBlock Text="Имя контактного лица:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtContactFirstName" Height="30"/>

                    <TextBlock Text="Отчество контактного лица:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtContactMiddleName" Height="30"/>

                    <TextBlock Text="Телефон:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtPhone" Height="30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="➕ Добавить" Click="Add_Click" Width="100" Margin="5"/>
                        <Button Content="💾 Обновить" Click="Update_Click" Width="100" Margin="5"/>
                        <Button Content="🗑 Удалить" Click="Delete_Click" Width="100" Margin="5"/>
                        <Button Content="❌ Очистить" Click="ClearForm_Click" Width="100" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="🔄 Обновить таблицу" Click="Refresh_Click" Width="150" Margin="5"/>
        </StackPanel>-->
    </Grid>
</Page>