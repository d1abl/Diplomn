<Page x:Class="Diplomn.Pages.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MainMenu">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с приветствием -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Аватар -->
                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                        Margin="0,0,20,0">
                    <Image x:Name="UserAvatar" Source="/Photos/istockavatar.png" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                        </Image.Clip>
                    </Image>
                </Border>

                <!-- Информация о пользователе -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWelcome" FontSize="28" FontWeight="Bold" 
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="Должность: " FontSize="20" Opacity="0.7"/>
                        <TextBlock x:Name="TxtPosition" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock x:Name="TxtAccessLevel" FontSize="20" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Дата входа: " FontSize="16" Opacity="0.7"/>
                        <TextBlock x:Name="TxtLoginDate" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Row="1" Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Добро пожаловать в систему управления магазином!" 
                           FontSize="38" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,-30,0,20"
                           Foreground="{DynamicResource AccentBrush}"/>

                <TextBlock Text="Oculus+" FontSize="38" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"
                           Foreground="{DynamicResource AccentBrush}"/>

                <TextBlock Text="Для навигации используйте меню сверху" 
                           FontSize="16" Opacity="0.6" 
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Краткая статистика -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Border Width="200" Padding="15" Margin="5" CornerRadius="8"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtProductsCount" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="товаров" FontSize="18" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Width="200" Padding="15" Margin="5" CornerRadius="8"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👥" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEmployeesCount" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="сотрудников" FontSize="18" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Width="200" Padding="15" Margin="5" CornerRadius="8"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotalSales" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="общая выручка" FontSize="18" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Width="200" Padding="15" Margin="5" CornerRadius="8"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏭" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtSuppliersCount" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="поставщиков" FontSize="18" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>