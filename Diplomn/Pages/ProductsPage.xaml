<Page x:Class="Diplomn.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="ProductsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="WelcomeText" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Управление товарами" FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: таблица товаров -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Список товаров" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <DataGrid x:Name="DataGridProducts" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="300" 
                          Margin="0,5,0,0"
                          SelectionChanged="DataGridProducts_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_товара}" Width="60"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование}" Width="180"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Цена_за_ед_продажа, StringFormat={}{0:N2} ₽}" Width="100"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Категории.Категория}" Width="120"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="1" Width="2" Background="#E0E0E0" Margin="10,0"/>

            <!-- Правая панель: форма редактирования -->
            <ScrollViewer Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Редактирование товара" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                    <!-- Фото товара с возможностью изменения -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="2" 
                        Width="120" Height="120" CornerRadius="10"
                        Margin="10" HorizontalAlignment="Center"
                        Cursor="Hand"
                        MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="ProductPhoto" 
                           Source="/Photos/istockproductphoto.png"
                           Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Нажмите на фото для изменения" 
                          FontSize="10" Foreground="Gray" 
                          HorizontalAlignment="Center" Margin="0,5,0,10"/>

                    <TextBlock Text="Код:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtProductId" IsReadOnly="True" Background="#F0F0F0" Height="30"/>

                    <TextBlock Text="Наименование:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtProductName" Height="30"/>

                    <TextBlock Text="Цена продажи:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtPrice" Height="30"/>

                    <TextBlock Text="Категория:" Margin="0,10,0,5"/>
                    <ComboBox x:Name="CmbCategory" Height="35" DisplayMemberPath="Категория" SelectedValuePath="Код_категория"/>

                    <TextBlock Text="Количество на складе:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtQuantity" Height="30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="➕ Добавить" Click="Add_Click" Width="100" Margin="5"/>
                        <Button Content="💾 Обновить" Click="Update_Click" Width="100" Margin="5"/>
                        <Button Content="🗑 Удалить" Click="Delete_Click" Width="100" Margin="5"/>
                        <Button Content="❌ Очистить" Click="ClearForm_Click" Width="100" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="🔄 Обновить таблицу" Click="Refresh_Click" Width="150" Margin="5"/>
        </StackPanel>-->
    </Grid>
</Page>