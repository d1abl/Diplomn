<Page x:Class="Diplomn.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      mc:Ignorable="d" 
      Title="ProductsPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Каталог товаров" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: карточки и фильтры -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска и кнопки -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по наименованию (Enter для применения)"
                                 KeyDown="TxtSearch_KeyDown"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию товара"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button x:Name="BtnApplyFilters" Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button x:Name="BtnClearFilters" Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button x:Name="BtnSaveReport" Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Фильтры -->
                <Expander Grid.Row="1" Header="⚙ Фильтры" IsExpanded="False" Margin="0,0,0,8">
                    <Border Padding="8">
                        <StackPanel>
                            <!-- Фильтр "В наличии" -->
                            <CheckBox x:Name="ChkInStock" Content="Только в наличии" 
                                      Margin="0,0,0,10" FontSize="12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Цена (от - до)" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtPriceMin" Width="70" Height="28" ToolTip="Цена от"
                                                 addons:PlaceholderBehavior.PlaceholderText="От"/>
                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="TxtPriceMax" Width="70" Height="28" ToolTip="Цена до"
                                                 addons:PlaceholderBehavior.PlaceholderText="До"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Количество (от - до)" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtQtyMin" Width="70" Height="28" ToolTip="Кол-во от"
                                                 addons:PlaceholderBehavior.PlaceholderText="От"/>
                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="TxtQtyMax" Width="70" Height="28" ToolTip="Кол-во до"
                                                 addons:PlaceholderBehavior.PlaceholderText="До"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Expander Header="Категории" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelCategories"/>
                                    </Expander>
                                    <Expander Header="Бренды" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelBrands"/>
                                    </Expander>
                                    <Expander Header="Производители" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelManufacturers"/>
                                    </Expander>
                                    <Expander Header="Материалы" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelMaterials"/>
                                    </Expander>
                                    <Expander Header="Фасовка" IsExpanded="False">
                                        <WrapPanel x:Name="PanelPacking"/>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Карточки товаров -->
                <ListView Grid.Row="2" x:Name="ListViewProducts"
                          SelectionMode="Single"
                          SelectionChanged="ListViewProducts_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" 
                                       Margin="5"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3.98" 
                                    Width="200"
                                    Height="300"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}, Mode=FindAncestor}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Фото товара -->
                                    <Border Width="150" Height="150" 
                                            CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,10">
                                        <Image Source="{Binding PhotoSource}" 
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Наименование -->
                                    <TextBlock Text="{Binding Наименование}" 
                                               FontWeight="Bold"
                                               FontSize="18"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Наименование}"
                                               TextWrapping="NoWrap"/>

                                    <!-- Категория -->
                                    <TextBlock Text="{Binding КатегорияНазвание}" 
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Цена -->
                                    <TextBlock Text="{Binding PriceDisplay}" 
                                               Margin="0,0,0,5"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>

                                    <!-- Количество -->
                                    <TextBlock Text="{Binding QuantityDisplay}" 
                                               Margin="0,0,0,5"
                                               FontSize="12"/>

                                    <!-- В наличии -->
                                    <TextBlock Text="{Binding StockStatus}" 
                                               FontSize="11"
                                               Margin="0,0,0,5"/>

                                    <StackPanel Orientation="Horizontal">
                                        <!-- Бренд -->
                                        <TextBlock Text="{Binding БрендНазвание}" 
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,5,0"
                                               ToolTip="{Binding БрендНазвание}"/>

                                        <!-- Производитель -->
                                        <TextBlock Text="{Binding ПроизводительНазвание}" 
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"   
                                               Margin="0,0,5,0"                                               
                                               ToolTip="{Binding ПроизводительНазвание}"/>

                                        <!-- Материал -->
                                        <TextBlock Text="{Binding МатериалНазвание}" 
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,5,0"
                                               ToolTip="{Binding МатериалНазвание}"/>

                                        <!-- Фасовка -->
                                        <TextBlock Text="{Binding ФасовкаНазвание}" 
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,5,0"
                                               ToolTip="{Binding ФасовкаНазвание}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" 
                    Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть: форма редактирования -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование товара" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <!-- Фото -->
                    <Border Width="150" Height="150" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="ProductPhoto" 
                               Source="/Photos/istockproductphoto.png"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Нажмите для изменения фото" FontSize="10" 
                              HorizontalAlignment="Center" Foreground="#99FFFFFF" Margin="0,0,0,15"/>

                    <!-- Поля формы -->
                    <TextBlock Text="Код товара" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtProductId" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Код товара"/>

                    <TextBlock Text="Наименование *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtProductName" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите наименование товара"/>

                    <TextBlock Text="Цена продажи *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPrice" Height="30" Margin="0,0,0,10"
                             addons:PlaceholderBehavior.PlaceholderText="Введите цену"/>

                    <TextBlock Text="Категория *" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbCategory" Height="32" Margin="0,0,0,10"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите категорию"
                              DisplayMemberPath="Категория" SelectedValuePath="Код_категория"/>

                    <TextBlock Text="Бренд" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbBrand" Height="32" Margin="0,0,0,10"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите бренд"
                              DisplayMemberPath="Наименование_бредна" SelectedValuePath="Код_бренда"/>

                    <TextBlock Text="Производитель" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbManufacturer" Height="32" Margin="0,0,0,10"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите производителя"
                              DisplayMemberPath="Наименование_произваодителя" SelectedValuePath="Код_производителя"/>

                    <TextBlock Text="Материал" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbMaterial" Height="32" Margin="0,0,0,10"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите материал"
                              DisplayMemberPath="Наименование_материала" SelectedValuePath="Код_материала"/>

                    <TextBlock Text="Фасовка" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbPacking" Height="32" Margin="0,0,0,10"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите фасовку"
                              DisplayMemberPath="Количество" SelectedValuePath="Код_фасовки"/>

                    <TextBlock Text="Количество на складе" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtQuantity" Height="30" IsReadOnly="True" Text="0" Margin="0,0,0,15"
                             addons:PlaceholderBehavior.PlaceholderText="Количество на складе"/>

                    <!-- Кнопки действий -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Добавить" Click="Add_Click" 
                                Width="90" Height="35" Margin="3"/>
                        <Button Content="Обновить" Click="Update_Click" 
                                Width="90" Height="35" Margin="3"/>
                        <Button Content="Удалить" Click="Delete_Click" 
                                Width="90" Height="35" Margin="3"/>
                        <Button Content="Очистить" Click="ClearForm_Click" 
                                Width="90" Height="35" Margin="3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>