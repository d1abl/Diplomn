<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Diplomn.Pages.ProductsPage"
      Title="Товары"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Каталог товаров" FontSize="13" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: карточки и фильтры -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска -->
                <Border Grid.Row="0" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию..."
                                 KeyDown="TxtSearch_KeyDown" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                            <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                            <Button Content="📊" Width="36" Height="32" Click="SaveReport_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Фильтры -->
                <Expander Grid.Row="1" Header="⚙ Фильтры" IsExpanded="False" Margin="0,0,0,8"
                          Foreground="{DynamicResource ForegroundBrush}">
                    <Border Padding="8">
                        <StackPanel>
                            <!-- В наличии, Цена и Количество в одной строке -->
                            <Grid Margin="0,-10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- В наличии - левая колонка -->
                                <CheckBox x:Name="ChkInStock" Content="В наличии" 
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource ForegroundBrush}"/>

                                <!-- Цена - средняя колонка -->
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="Цена (от — до)" FontSize="11" Margin="0,0,0,4"
                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtPriceMin" Height="28"
                     addons:PlaceholderBehavior.PlaceholderText="От"/>
                                        <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="8,0"
                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBox Grid.Column="2" x:Name="TxtPriceMax" Height="28"
                     addons:PlaceholderBehavior.PlaceholderText="До"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Количество - правая колонка -->
                                <StackPanel Grid.Column="2" Margin="15,0,0,0">
                                    <TextBlock Text="Количество (от — до)" FontSize="11" Margin="0,0,0,4"
                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtQtyMin" Height="28"
                     addons:PlaceholderBehavior.PlaceholderText="От"/>
                                        <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="8,0"
                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBox Grid.Column="2" x:Name="TxtQtyMax" Height="28"
                     addons:PlaceholderBehavior.PlaceholderText="До"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Категории, бренды и т.д. -->
                            <ScrollViewer MaxHeight="221" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Категории -->
                                    <Expander Header="Категории" IsExpanded="False" Margin="0,0,0,5"
          Foreground="{DynamicResource ForegroundBrush}">
                                        <StackPanel>
                                            <TextBox x:Name="TxtSearchCategories" Height="28" Margin="0,0,0,5"
                 addons:PlaceholderBehavior.PlaceholderText="Поиск категории..."
                 TextChanged="FilterCategories_TextChanged"/>
                                            <UniformGrid x:Name="PanelCategories" Columns="5" 
                     HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Бренды -->
                                    <Expander Header="Бренды" IsExpanded="False" Margin="0,0,0,5"
          Foreground="{DynamicResource ForegroundBrush}">
                                        <StackPanel>
                                            <TextBox x:Name="TxtSearchBrands" Height="28" Margin="0,0,0,5"
                 addons:PlaceholderBehavior.PlaceholderText="Поиск бренда..."
                 TextChanged="FilterBrands_TextChanged"/>
                                            <UniformGrid x:Name="PanelBrands" Columns="5" 
                     HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Производители -->
                                    <Expander Header="Производители" IsExpanded="False" Margin="0,0,0,5"
          Foreground="{DynamicResource ForegroundBrush}">
                                        <StackPanel>
                                            <TextBox x:Name="TxtSearchManufacturers" Height="28" Margin="0,0,0,5"
                 addons:PlaceholderBehavior.PlaceholderText="Поиск производителя..."
                 TextChanged="FilterManufacturers_TextChanged"/>
                                            <UniformGrid x:Name="PanelManufacturers" Columns="5" 
                     HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Материалы -->
                                    <Expander Header="Материалы" IsExpanded="False" Margin="0,0,0,5"
          Foreground="{DynamicResource ForegroundBrush}">
                                        <StackPanel>
                                            <TextBox x:Name="TxtSearchMaterials" Height="28" Margin="0,0,0,5"
                 addons:PlaceholderBehavior.PlaceholderText="Поиск материала..."
                 TextChanged="FilterMaterials_TextChanged"/>
                                            <UniformGrid x:Name="PanelMaterials" Columns="5" 
                     HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Фасовка -->
                                    <Expander Header="Фасовка" IsExpanded="False"
          Foreground="{DynamicResource ForegroundBrush}">
                                        <StackPanel>
                                            <TextBox x:Name="TxtSearchPacking" Height="28" Margin="0,0,0,5"
                 addons:PlaceholderBehavior.PlaceholderText="Поиск фасовки..."
                 TextChanged="FilterPacking_TextChanged"/>
                                            <UniformGrid x:Name="PanelPacking" Columns="5" 
                     HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Карточки товаров -->
                <ListView Grid.Row="2" x:Name="ListViewProducts"
                          SelectionMode="Single"
                          SelectionChanged="ListViewProducts_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="5"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Width="200" Height="275"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}, Mode=FindAncestor}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Фото -->
                                    <Border Width="120" Height="120" CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Наименование -->
                                    <TextBlock Text="{Binding Наименование}" FontWeight="Bold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Наименование}"
                                               Foreground="{DynamicResource ForegroundBrush}"/>

                                    <!-- Категория -->
                                    <TextBlock Text="{Binding КатегорияНазвание}" Margin="0,3,0,6"
                                               TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.7"
                                               Foreground="{DynamicResource ForegroundBrush}"/>

                                    <!-- Цена -->
                                    <TextBlock Text="{Binding PriceDisplay}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>

                                    <!-- Количество -->
                                    <TextBlock Text="{Binding QuantityDisplay}" FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource ForegroundBrush}"/>

                                    <!-- Статус -->
                                    <TextBlock Text="{Binding StockStatus}" FontSize="11"
                                               Foreground="{DynamicResource ForegroundBrush}"/>

                                    <!-- Детали -->
                                    <WrapPanel Margin="0,5,0,0" Width="180">
                                        <TextBlock Text="{Binding БрендНазвание}" FontSize="9" Margin="0,0,4,0"
                                                   TextTrimming="CharacterEllipsis" Opacity="0.6"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding ПроизводительНазвание}" FontSize="9" Margin="0,0,4,0"
                                                   TextTrimming="CharacterEllipsis" Opacity="0.6"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding МатериалНазвание}" FontSize="9" Margin="0,0,4,0"
                                                   TextTrimming="CharacterEllipsis" Opacity="0.6"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding ФасовкаНазвание}" FontSize="9"
                                                   TextTrimming="CharacterEllipsis" Opacity="0.6"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" 
                    Opacity="0.2" Margin="15,0"/>

            <!-- Правая панель: форма редактирования -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование товара" FontWeight="Bold" FontSize="14" 
                               Margin="0,0,0,15" Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Фото -->
                    <Border Width="150" Height="150" CornerRadius="8"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="ProductPhoto" Source="/Photos/istockproductphoto.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Нажмите для изменения фото" FontSize="10" 
                               HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,15"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Код -->
                    <TextBlock Text="Код товара" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtProductId" IsReadOnly="True" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Код товара" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                    <!-- Наименование -->
                    <TextBlock Text="Наименование *" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtProductName" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Введите наименование"/>

                    <!-- Цена -->
                    <TextBlock Text="Цена продажи *" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPrice" Height="32" Margin="0,0,0,12"
                             addons:PlaceholderBehavior.PlaceholderText="Введите цену"/>

                    <!-- Категория -->
                    <TextBlock Text="Категория *" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCategory" Height="34" Margin="0,0,0,12"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите категорию"
                              DisplayMemberPath="Категория" SelectedValuePath="Код_категория"/>

                    <!-- Бренд -->
                    <TextBlock Text="Бренд" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBrand" Height="34" Margin="0,0,0,12"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите бренд"
                              DisplayMemberPath="Наименование_бредна" SelectedValuePath="Код_бренда"/>

                    <!-- Производитель -->
                    <TextBlock Text="Производитель" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbManufacturer" Height="34" Margin="0,0,0,12"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите производителя"
                              DisplayMemberPath="Наименование_произваодителя" SelectedValuePath="Код_производителя"/>

                    <!-- Материал -->
                    <TextBlock Text="Материал" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbMaterial" Height="34" Margin="0,0,0,12"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите материал"
                              DisplayMemberPath="Наименование_материала" SelectedValuePath="Код_материала"/>

                    <!-- Фасовка -->
                    <TextBlock Text="Фасовка" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPacking" Height="34" Margin="0,0,0,12"
                              IsEditable="True"
                              Style="{DynamicResource PlaceholderComboBox}"
                              Tag="Выберите фасовку"
                              DisplayMemberPath="Количество" SelectedValuePath="Код_фасовки"/>

                    <!-- Количество на складе -->
                    <TextBlock Text="Количество на складе" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtQuantity" Height="32" IsReadOnly="True" 
                             Text="0" Margin="0,0,0,15"
                             addons:PlaceholderBehavior.PlaceholderText="Количество на складе"/>

                    <!-- Кнопки действий -->
                    <WrapPanel x:Name="ActionButtonsPanel" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>