<Page x:Class="Diplomn.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProductsPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление товарами" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: таблица и фильтры -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска и кнопки -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по наименованию (Enter для применения)"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button x:Name="BtnApplyFilters" Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button x:Name="BtnClearFilters" Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button x:Name="BtnSaveReport" Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Фильтры -->
                <Expander Grid.Row="1" Header="⚙ Фильтры" IsExpanded="False" Margin="0,0,0,8">
                    <Border Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Цена (от - до)" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtPriceMin" Width="70" Height="28" ToolTip="Цена от"/>
                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="TxtPriceMax" Width="70" Height="28" ToolTip="Цена до"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Количество (от - до)" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtQtyMin" Width="70" Height="28" ToolTip="Кол-во от"/>
                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="TxtQtyMax" Width="70" Height="28" ToolTip="Кол-во до"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Expander Header="Категории" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelCategories"/>
                                    </Expander>
                                    <Expander Header="Бренды" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelBrands"/>
                                    </Expander>
                                    <Expander Header="Производители" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelManufacturers"/>
                                    </Expander>
                                    <Expander Header="Материалы" IsExpanded="False" Margin="0,0,0,3">
                                        <WrapPanel x:Name="PanelMaterials"/>
                                    </Expander>
                                    <Expander Header="Фасовка" IsExpanded="False">
                                        <WrapPanel x:Name="PanelPacking"/>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Таблица товаров -->
                <DataGrid Grid.Row="2" x:Name="DataGridProducts" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="DataGridProducts_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_товара}" Width="50"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование}" Width="150"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Цена_за_ед_продажа, StringFormat={}{0:N2} ₽}" Width="90"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Категории.Категория}" Width="100"/>
                        <DataGridTextColumn Header="Бренд" Binding="{Binding Бренд.Наименование_бредна}" Width="110"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" 
                    Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть: форма редактирования -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование товара" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <!-- Фото -->
                    <Border Width="150" Height="150" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="ProductPhoto" 
                               Source="/Photos/istockproductphoto.png"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Нажмите для изменения фото" FontSize="10" 
                              HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,15"/>

                    <!-- Поля формы -->
                    <TextBlock Text="Код товара" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtProductId" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Наименование *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtProductName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Цена продажи *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPrice" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Категория *" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbCategory" Height="32" Margin="0,0,0,10"
                              DisplayMemberPath="Категория" SelectedValuePath="Код_категория"/>

                    <TextBlock Text="Бренд" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbBrand" Height="32" Margin="0,0,0,10"
                              DisplayMemberPath="Наименование_бредна" SelectedValuePath="Код_бренда"/>

                    <TextBlock Text="Производитель" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbManufacturer" Height="32" Margin="0,0,0,10"
                              DisplayMemberPath="Наименование_произваодителя" SelectedValuePath="Код_производителя"/>

                    <TextBlock Text="Материал" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbMaterial" Height="32" Margin="0,0,0,10"
                              DisplayMemberPath="Наименование_материала" SelectedValuePath="Код_материала"/>

                    <TextBlock Text="Фасовка" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbPacking" Height="32" Margin="0,0,0,10"
                              DisplayMemberPath="Количество" SelectedValuePath="Код_фасовки"/>

                    <TextBlock Text="Количество на складе" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtQuantity" Height="30" IsReadOnly="True" Text="0" Margin="0,0,0,15"/>

                    <!-- Кнопки действий -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Добавить" Click="Add_Click" 
                                Width="90" Height="35" Margin="3"/>
                        <Button Content="Обновить" Click="Update_Click" 
                                Width="90" Height="35" Margin="3"/>
                        <Button Content="Удалить" Click="Delete_Click" 
                                Width="90" Height="35" Margin="3"/>
                        <Button Content="Очистить" Click="ClearForm_Click" 
                                Width="90" Height="35" Margin="3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>