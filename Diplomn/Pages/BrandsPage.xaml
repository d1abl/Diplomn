<Page x:Class="Diplomn.Pages.BrandsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="Бренды"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Бренды" 
                           FontSize="18" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Управление брендами товаров" 
                           FontSize="13" 
                           Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: таблица -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска -->
                <Border Grid.Row="0" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" 
                                 Height="32"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по названию..."
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                            <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица брендов -->
                <DataGrid Grid.Row="1" 
                          x:Name="DataGridBrands"
                          SelectionChanged="DataGridBrands_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" 
                                           Binding="{Binding Код_бренда}" 
                                           Width="60"/>
                        <DataGridTextColumn Header="Наименование" 
                                           Binding="{Binding Наименование_бредна}" 
                                           Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Column="1" 
                    Width="1" 
                    Background="{DynamicResource BorderBrush}" 
                    Opacity="0.2" 
                    Margin="15,0"/>

            <!-- Правая панель: форма редактирования -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Редактирование бренда" 
                           FontWeight="Bold" 
                           FontSize="14" 
                           Margin="0,0,0,15"
                           Foreground="{DynamicResource ForegroundBrush}"/>

                <TextBlock Text="Код" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtBrandId" 
                         IsReadOnly="True" 
                         Height="32" 
                         Margin="0,0,0,12"
                         addons:PlaceholderBehavior.PlaceholderText="Код бренда"/>

                <TextBlock Text="Наименование *" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtBrandName" 
                         Height="32" 
                         Margin="0,0,0,15"
                         addons:PlaceholderBehavior.PlaceholderText="Введите название бренда"/>

                <!-- Кнопки действий -->
                <WrapPanel x:Name="ActionButtonsPanel" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>