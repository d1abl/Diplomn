<Page x:Class="Diplomn.Pages.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="Категории"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Категории" 
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Управление категориями товаров" 
                           FontSize="13" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Border Grid.Row="0" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по названию..."
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                            <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица -->
                <DataGrid Grid.Row="1" x:Name="DataGridCategories"
                          SelectionChanged="DataGridCategories_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_категория}" Width="60"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Категория}" Width="150"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Описание_категории}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" 
                    Opacity="0.2" Margin="15,0"/>

            <!-- Правая панель -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Редактирование категории" 
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                           Foreground="{DynamicResource ForegroundBrush}"/>

                <TextBlock Text="Код" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCategoryId" IsReadOnly="True" Height="32" Margin="0,0,0,12"
                         addons:PlaceholderBehavior.PlaceholderText="Код категории" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                <TextBlock Text="Название *" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCategoryName" Height="32" Margin="0,0,0,12"
                         addons:PlaceholderBehavior.PlaceholderText="Введите название"/>

                <TextBlock Text="Описание" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescription" Height="80" Margin="0,0,0,15"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         addons:PlaceholderBehavior.PlaceholderText="Введите описание (необязательно)"/>

                <WrapPanel x:Name="ActionButtonsPanel" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>