<Page x:Class="Diplomn.Pages.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CategoriesPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Категории" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление категориями товаров" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по названию категории (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица -->
                <DataGrid Grid.Row="1" x:Name="DataGridCategories" 
                          SelectionChanged="DataGridCategories_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_категория}" Width="60"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Категория}" Width="150"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Описание_категории}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Редактирование категории" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Код" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtCategoryId" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Название категории *" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtCategoryName" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Описание" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtDescription" TextWrapping="Wrap" AcceptsReturn="True"
                         Height="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="Добавить" Click="Add_Click" Width="90" Height="35" Margin="3"/>
                    <Button Content="Обновить" Click="Update_Click" Width="90" Height="35" Margin="3"/>
                    <Button Content="Удалить" Click="Delete_Click" Width="90" Height="35" Margin="3"/>
                    <Button Content="Очистить" Click="ClearForm_Click" Width="90" Height="35" Margin="3"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>