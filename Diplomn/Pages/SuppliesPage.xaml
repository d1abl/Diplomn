<Page x:Class="Diplomn.Pages.SuppliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d" 
      Title="SuppliesPage">

    <Grid Margin="25 15 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="PageModeText" Text="Управление поставками" FontSize="16" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Режим просмотра поставок -->
            <Grid x:Name="SuppliesViewGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель: карточки поставок -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поиск и кнопки -->
                    <Border Grid.Row="0" Padding="5" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Height="32" FontSize="19" 
                                     ToolTip="Поиск по товару в поставке (Enter для поиска)"
                                     KeyDown="TxtSearch_KeyDown"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск по товару в поставке"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="40" Height="32"
                                        Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                                <Button Content="✕" Width="40" Height="32"
                                        Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                                <Button Content="📊" Width="40" Height="32"
                                        Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Фильтры -->
                    <Expander Grid.Row="1" Header="⚙ Фильтры и сортировка" IsExpanded="False" Margin="0,-10,0,10"
          Foreground="{DynamicResource ForegroundBrush}">
                        <Border Padding="8" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel>

                                <StackPanel Margin="0,5,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>                                       
                                        
                                        <!-- Фильтр по дате -->
                                    <TextBlock Grid.Column="0" Text="Дата поставки (от — до)" FontSize="18" Margin="0,-15,0,50"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker x:Name="DateFrom" Height="35"/>
                                        <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="6,0"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                                        <DatePicker Grid.Column="2" x:Name="DateTo" Height="35"/>
                                    </Grid>
                                    
                                    <!-- Сортировка -->
                                        <TextBlock Grid.Column="1" Text="Сортировка" FontSize="18" FontWeight="Bold" Margin="10,-15,0,0"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid Grid.Column="1" Margin="10 0 -10 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BtnSortByDate" Height="35" CornerRadius="4" Padding="6,3" Margin="0,0,0,0" Grid.Column="0"
                            Background="{DynamicResource BackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonDown="ToggleDateSort_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅 По дате" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="DateSortArrow" Text="↑" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                            <Border x:Name="BtnSortByAmount" Height="35" CornerRadius="4" Padding="6,3" Margin="10,0,0,0" Grid.Column="1"
                            Background="{DynamicResource BackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonDown="ToggleAmountSort_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💰 По сумме" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="AmountSortArrow" Text="" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    </Grid>
                                </StackPanel>

                                <!-- Сотрудник и Поставщик -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Фильтр по сотруднику -->
                                    <Border  Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,5,0">
                                        <StackPanel>
                                            <TextBlock Text="Сотрудник" FontSize="18" Margin="0,0,0,4"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBox x:Name="TxtSearchEmployee" Height="28"
                             addons:PlaceholderBehavior.PlaceholderText="Поиск сотрудника..."
                             TextChanged="FilterEmployees_TextChanged"/>
                                            <UniformGrid x:Name="PanelEmployees" Columns="2" 
                                 HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Фильтр по поставщику -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8"  Grid.Column="1" Margin="5,10 0,0">
                                        <StackPanel>
                                            <TextBlock Text="Поставщик" FontSize="18" Margin="0,0,0,4"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBox x:Name="TxtSearchSupplier" Height="28"
                             addons:PlaceholderBehavior.PlaceholderText="Поиск поставщика..."
                             TextChanged="FilterSuppliers_TextChanged"/>
                                            <UniformGrid x:Name="PanelSuppliers" Columns="1" 
                                 HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>
                    
                    <!-- Карточки поставок -->
                    <ListView Grid.Row="2" x:Name="ListViewSupplies"
                              SelectionMode="Single"
                              SelectionChanged="ListViewSupplies_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" 
                                        Width="200"
                                        Height="150"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SupplyDisplay}" 
                                                   FontWeight="Bold"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}"/>

                                        <TextBlock Text="{Binding DateDisplay}" 
                                                   Margin="0,0,0,0"
                                                   FontSize="17"/>

                                        <TextBlock Text="{Binding EmployeeDisplay}" 
                                                   Margin="0,5,0,0"
                                                   FontSize="15"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding SupplierDisplay}" 
                                                   Margin="0,5,0,0"
                                                   FontSize="17"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding TotalDisplay}" 
                                                   Margin="0,8,0,0"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель: информация о поставке -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,50,0" >
                        <TextBlock Text="Информация о поставке" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <TextBlock Text="Код поставки:" FontSize="19" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSupplyId" IsReadOnly="True" Height="30" Margin="0,0,0,10" FontSize="19" 
                 addons:PlaceholderBehavior.PlaceholderText="Код поставки" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Дата оформления:" FontSize="19" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSupplyDate" IsReadOnly="True" Height="30" Margin="0,0,0,10" FontSize="19"
                 addons:PlaceholderBehavior.PlaceholderText="Дата оформления" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Сотрудник:" FontSize="19" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtEmployee" IsReadOnly="True" Height="30" Margin="0,0,0,10" FontSize="19"
                 addons:PlaceholderBehavior.PlaceholderText="Сотрудник" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Поставщик:" FontSize="19" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSupplier" IsReadOnly="True" Height="30" Margin="0,0,0,15" FontSize="19"
                 addons:PlaceholderBehavior.PlaceholderText="Поставщик" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Состав поставки:" FontWeight="Bold" Margin="0,0,0,8" FontSize="19"/>

                                <!-- Список товаров в поставке -->
                                <ListView x:Name="ListViewSupplyItems"
                                          MinHeight="200"
                                          MaxHeight="428"
                                          SelectionMode="Single"
                                          Margin="0,0,0,15"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" 
                                    CornerRadius="3"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    Margin="0,0,10,0">
                                                        <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="19"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="18" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" FontSize="19"/>
                                                        </StackPanel>
                                                        
                                                    </StackPanel>
                                                   
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel x:Name="TotalPanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                            <TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="21" />
                            <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="19" 
                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Режим создания новой поставки -->
            <Grid x:Name="NewSupplyGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель - каталог товаров -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Каталог товаров" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <!-- Поиск и фильтры -->
                    <Border Grid.Row="1" Padding="5" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtProductSearch" Height="32" Grid.Column="0"
                                     ToolTip="Поиск по наименованию (Enter для поиска)"
                                     KeyDown="TxtProductSearch_KeyDown"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию товара"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="40" Height="32" Click="ApplyProductFilters_Click"/>
                                <Button Content="✕" Width="40" Height="32" Click="ClearProductFilters_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                            <!-- Выбор поставщика для новой поставки -->
                            <Border Grid.Row="2" Padding="5" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Поставщик:" FontWeight="Bold" FontSize="19" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbNewSupplySupplier" Height="30" Style="{DynamicResource PlaceholderComboBox}" FontSize="19"
                                      DisplayMemberPath="Наименование_поставщика"
                                      SelectedValuePath="Код_поставщика"/>
                                </StackPanel>
                            </Border>

                    <!-- Фильтры каталога -->
                    <Expander Grid.Row="3" Header="⚙ Фильтры каталога" IsExpanded="False" Margin="0,0,0,8"
          Foreground="{DynamicResource ForegroundBrush}">
                        <Border Padding="8" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="0 -10 0 0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkNewSupplyInStock" Content="В наличии" Margin="30 15 20 0" 
                          VerticalAlignment="Center" FontSize="19"
                          Foreground="{DynamicResource ForegroundBrush}"/>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="Цена (от — до)" FontSize="18" Margin="0,0,0,4"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtNewSupplyPriceMin" Height="28"
                                 addons:PlaceholderBehavior.PlaceholderText="От"/>
                                            <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="6,0"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBox Grid.Column="2" x:Name="TxtNewSupplyPriceMax" Height="28"
                                 addons:PlaceholderBehavior.PlaceholderText="До"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Expander Header="Категории" IsExpanded="False" Margin="0,0,0,5"
                              Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSupplySearchCategories" Height="28" Margin="0,0,0,5"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск категории..."
                                     TextChanged="NewSupplyFilterCategories_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSupplyCategories" Columns="4" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Бренды" IsExpanded="False" Margin="0,0,0,5"
                              Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSupplySearchBrands" Height="28" Margin="0,0,0,5"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск бренда..."
                                     TextChanged="NewSupplyFilterBrands_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSupplyBrands" Columns="4" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Производители" IsExpanded="False" Margin="0,0,0,5"
                              Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSupplySearchManufacturers" Height="28" Margin="0,0,0,5"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск производителя..."
                                     TextChanged="NewSupplyFilterManufacturers_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSupplyManufacturers" Columns="4" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Материалы" IsExpanded="False" Margin="0,0,0,5"
                              Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSupplySearchMaterials" Height="28" Margin="0,0,0,5"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск материала..."
                                     TextChanged="NewSupplyFilterMaterials_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSupplyMaterials" Columns="4" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Фасовка" IsExpanded="False"
                              Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSupplySearchPacking" Height="28" Margin="0,0,0,5"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск фасовки..."
                                     TextChanged="NewSupplyFilterPacking_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSupplyPacking" Columns="4" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Expander>
                    
                    <!-- Список товаров карточками -->
                    <ListView Grid.Row="4" x:Name="ListViewProducts"
                              SelectionMode="Single"
                              SelectionChanged="ListViewProducts_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" 
                                        Width="200"
                                        Height="310"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Width="100" Height="100" 
                                                CornerRadius="4"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,8">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Наименование}" 
                                                   FontWeight="Bold"
                                                   FontSize="20"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Наименование}"
                                                   TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding PriceDisplay}" 
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   FontSize="16"
                                                   Margin="0,2,0,0"
                                                   Opacity="0.7"/>
                                        
                                        <TextBlock Text="{Binding QuantityDisplay}" 
                                                   FontSize="14"
                                                   Margin="0,2,0,4"/>

                                        <TextBlock Text="Кол-во для добавления:" FontSize="16" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtItemQuantity"
                                                     Text="1"
                                                     Width="55" 
                                                     Height="27"
                                                     TextAlignment="Center"
                                                     Margin="0,0,5,0"
                                                     PreviewTextInput="TxtItemQuantity_PreviewTextInput"/>
                                            <Slider Grid.Column="1" 
                                                    x:Name="QuantitySlider"
                                                    Width="100"
                                                    Minimum="0" 
                                                    Maximum="100" 
                                                    Value="0"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="QuantitySlider_ValueChanged"
                                                    Tag="{Binding}"/>
                                        </Grid>

                                        <Button x:Name="BtnAddToSupply" 
                                                Content="➕ Добавить" 
                                                Click="AddToSupplyItem_Click"
                                                Height="28"
                                                Margin="0,5,0,0"
                                                FontSize="18"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель - корзина поставки -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Товары в поставке" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <ListView Grid.Row="1" x:Name="ListViewNewSupplyItems"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" 
                                                CornerRadius="3"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="19"/>
                                            <StackPanel Orientation="Horizontal">
                                                
                                            <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="18" Opacity="0.7"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" FontSize="18"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="✕" Width="30" Height="25" Margin="15,0,0,0"
                                                Click="RemoveNewSupplyItem_Click" Tag="{Binding}"
                                                ToolTip="Удалить позицию"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Нижняя панель с кнопками -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <StackPanel x:Name="ViewModeButtons" Orientation="Horizontal"/>
            <StackPanel x:Name="NewSupplyModeButtons" Orientation="Horizontal" Visibility="Collapsed"/>
        </StackPanel>
        
        <!-- Панель итого для режима создания -->
        <Border x:Name="NewSupplyTotalPanel" Grid.Row="2" Margin="0,15,170,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left" Visibility="Collapsed"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtNewSupplyTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Панель общей суммы поставок -->
        <Border x:Name="GrandTotalPanel" Grid.Row="2" Margin="0,15,0,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰 Общая сумма поставок: " FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtGrandTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>