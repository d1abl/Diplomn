<Page x:Class="Diplomn.Pages.SuppliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SuppliesPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Поставки" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление поставками" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поиск и кнопки -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по коду поставки (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Фильтры -->
                <Expander Grid.Row="1" Header="⚙ Фильтры" IsExpanded="False" Margin="0,0,0,8">
                    <Border Padding="8">
                        <StackPanel>
                            <!-- Фильтр по дате -->
                            <TextBlock Text="Период" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Дата с:" FontSize="11" Margin="0,0,0,3"/>
                                    <DatePicker x:Name="DateFrom" Height="30"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Дата по:" FontSize="11" Margin="0,0,0,3"/>
                                    <DatePicker x:Name="DateTo" Height="30"/>
                                </StackPanel>
                            </Grid>

                            <!-- Фильтр по сотрудникам -->
                            <TextBlock Text="Сотрудники" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>

                            <!-- Кнопки управления выбором -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Button Content="Выбрать всех" Click="SelectAllEmployees_Click" 
                                        FontSize="11" Height="25" Width="100" Margin="0,0,5,0"/>
                                <Button Content="Снять выбор" Click="DeselectAllEmployees_Click" 
                                        FontSize="11" Height="25" Width="100"/>
                            </StackPanel>

                            <!-- Список сотрудников с чекбоксами -->
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="EmployeesCheckList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" 
                                                      IsChecked="{Binding IsSelected}"
                                                      Tag="{Binding Id}"
                                                      Margin="2,3"
                                                      FontSize="12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Таблица -->
                <DataGrid Grid.Row="2" x:Name="DataGridSupplies" 
                          SelectionChanged="DataGridSupplies_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Код_поставки}" Width="60"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Дата_оформления_постивки, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding Сотрудники.Фамилия}" Width="110"/>
                        <DataGridTextColumn Header="Сумма" Width="120">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Код_поставки" StringFormat="{}{0:N2} ₽"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Итого -->
                <Border Grid.Row="3" Padding="10" CornerRadius="4" Margin="0,5,0,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Общая сумма поставок: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalSupplies" FontWeight="Bold" FontSize="14" 
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Детали поставки" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="Код поставки" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSupplyId" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Дата оформления" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSupplyDate" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Сотрудник" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtEmployee" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Поставщик" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSupplier" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Состав поставки" FontWeight="Bold" FontSize="13" Margin="0,10,0,5"/>
                    <DataGrid x:Name="DataGridSupplyItems" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Товар}" Width="140"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="60"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} ₽}" Width="90"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource BorderBrush}" Padding="10" CornerRadius="4" 
                            Margin="0,10,0,0" Opacity="0.9">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Сумма поставки:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource BackgroundBrush}"/>
                            <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource BackgroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Новая поставка" Click="NewSupply_Click" Width="110" Margin="3"/>
                        <Button Content="Удалить" Click="DeleteSupply_Click" Width="90" Margin="3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>