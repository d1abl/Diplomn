<Page x:Class="Diplomn.Pages.SuppliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d" 
      Title="SuppliesPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="PageModeText" Text="Управление поставками" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Режим просмотра поставок -->
            <Grid x:Name="SuppliesViewGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель: карточки поставок -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поиск и кнопки -->
                    <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Height="32" 
                                     ToolTip="Поиск по товару в поставке (Enter для поиска)"
                                     KeyDown="TxtSearch_KeyDown"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск по товару в поставке"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="40" Height="32"
                                        Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                                <Button Content="✕" Width="40" Height="32"
                                        Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                                <Button Content="📊" Width="40" Height="32"
                                        Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Фильтры -->
                    <Expander Grid.Row="1" Header="⚙ Фильтры и сортировка" IsExpanded="False" Margin="0,0,0,8">
                        <Border Padding="8">
                            <StackPanel>
                                <!-- Фильтр по дате -->
                                <TextBlock Text="Дата поставки" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="От" FontSize="10" Margin="0,0,0,2"/>
                                        <DatePicker x:Name="DateFrom" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="До" FontSize="10" Margin="0,0,0,2"/>
                                        <DatePicker x:Name="DateTo" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Фильтр по сотруднику -->
                                <TextBlock Text="Сотрудник" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbEmployee" Height="28" Margin="0,0,0,10"
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Код_сотрудника"/>

                                <!-- Фильтр по поставщику -->
                                <TextBlock Text="Поставщик" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbSupplier" Height="28" Margin="0,0,0,10"
                                          DisplayMemberPath="Наименование_поставщика"
                                          SelectedValuePath="Код_поставщика"/>

                                <!-- Сортировка -->
                                <TextBlock Text="Сортировка" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Margin="0,0,0,5">
                                    <RadioButton x:Name="RbSortByDate" Content="По дате (новые сначала)" 
                                                 IsChecked="True" Margin="0,2,0,2" FontSize="11"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByDateAsc" Content="По дате (старые сначала)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByAmount" Content="По сумме (по убыванию)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByAmountAsc" Content="По сумме (по возрастанию)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByCode" Content="По коду поставки (по убыванию)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByCodeAsc" Content="По коду поставки (по возрастанию)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Checked="SortChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- Карточки поставок -->
                    <ListView Grid.Row="2" x:Name="ListViewSupplies"
                              SelectionMode="Single"
                              SelectionChanged="ListViewSupplies_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" 
                                        Width="220"
                                        Height="160"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SupplyDisplay}" 
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"/>

                                        <TextBlock Text="{Binding DateDisplay}" 
                                                   Margin="0,8,0,0"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding EmployeeDisplay}" 
                                                   Margin="0,5,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding SupplierDisplay}" 
                                                   Margin="0,5,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding TotalDisplay}" 
                                                   Margin="0,8,0,0"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель: информация о поставке -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Информация о поставке" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <TextBlock Text="Код поставки:" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSupplyId" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                                 addons:PlaceholderBehavior.PlaceholderText="Код поставки"/>

                        <TextBlock Text="Дата оформления:" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSupplyDate" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                                 addons:PlaceholderBehavior.PlaceholderText="Дата оформления"/>

                        <TextBlock Text="Сотрудник:" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtEmployee" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                                 addons:PlaceholderBehavior.PlaceholderText="Сотрудник"/>

                        <TextBlock Text="Поставщик:" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSupplier" IsReadOnly="True" Height="30" Margin="0,0,0,15"
                                 addons:PlaceholderBehavior.PlaceholderText="Поставщик"/>

                        <TextBlock Text="Состав поставки:" FontWeight="Bold" Margin="0,0,0,8"/>

                        <!-- Список товаров в поставке -->
                        <ListView x:Name="ListViewSupplyItems"
                                  SelectionMode="Single"
                                  Height="200"
                                  Margin="0,0,0,15"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" 
                                                    CornerRadius="3"
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="TotalPanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                            <TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="16" 
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Режим создания новой поставки -->
            <Grid x:Name="NewSupplyGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель - каталог товаров -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Каталог товаров" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <!-- Поиск и фильтры -->
                    <Border Grid.Row="1" Padding="5" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtProductSearch" Height="32" 
                                     ToolTip="Поиск по наименованию (Enter для поиска)"
                                     KeyDown="TxtProductSearch_KeyDown"
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию товара"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="40" Height="32" Click="ApplyProductFilters_Click"/>
                                <Button Content="✕" Width="40" Height="32" Click="ClearProductFilters_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Выбор поставщика для новой поставки -->
                    <Border Grid.Row="2" Padding="5" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Поставщик:" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbNewSupplySupplier" Height="30"
                                      DisplayMemberPath="Наименование_поставщика"
                                      SelectedValuePath="Код_поставщика"/>
                        </StackPanel>
                    </Border>

                    <!-- Список товаров карточками -->
                    <ListView Grid.Row="3" x:Name="ListViewProducts"
                              SelectionMode="Single"
                              SelectionChanged="ListViewProducts_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" 
                                        Width="220"
                                        Height="300"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Width="100" Height="100" 
                                                CornerRadius="4"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,8">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Наименование}" 
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Наименование}"
                                                   TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   Opacity="0.7"/>
                                        <TextBlock Text="{Binding PriceDisplay}" 
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding QuantityDisplay}" 
                                                   FontSize="11"
                                                   Margin="0,2,0,8"/>

                                        <TextBlock Text="Кол-во для добавления:" FontSize="11" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtItemQuantity"
                                                     Text="1"
                                                     Width="55" 
                                                     Height="24"
                                                     TextAlignment="Center"
                                                     Margin="0,0,5,0"
                                                     PreviewTextInput="TxtItemQuantity_PreviewTextInput"
                                                     LostFocus="TxtItemQuantity_LostFocus"/>
                                            <Slider Grid.Column="1" 
                                                    x:Name="QuantitySlider"
                                                    Width="100"
                                                    Minimum="0" 
                                                    Maximum="100" 
                                                    Value="0"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="QuantitySlider_ValueChanged"
                                                    Tag="{Binding}"/>
                                        </Grid>

                                        <Button x:Name="BtnAddToSupply" 
                                                Content="➕ Добавить" 
                                                Click="AddToSupplyItem_Click"
                                                Height="28"
                                                Margin="0,5,0,0"
                                                FontSize="11"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель - корзина поставки -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Товары в поставке" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <ListView Grid.Row="1" x:Name="ListViewNewSupplyItems"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" 
                                                CornerRadius="3"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                                        <Button Grid.Column="3" Content="✕" Width="30" Height="25" Margin="5,0,0,0"
                                                Click="RemoveNewSupplyItem_Click" Tag="{Binding}"
                                                ToolTip="Удалить позицию"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" Cursor="Hand">
            <StackPanel x:Name="ViewModeButtons" Orientation="Horizontal">
                <Button Content="➕ Новая поставка" Click="NewSupply_Click" Width="130" Margin="5" Height="35" Cursor="Hand"/>
                <Grid Margin="5" Width="120" >
                    <Button x:Name="BtnEditSupply" Content="✏ Редактировать" 
            Click="EditSupply_Click" Height="35" IsEnabled="False"/>
                    <Border x:Name="BtnEditSupplyOverlay" Background="Transparent" 
            Visibility="Collapsed" ToolTip=""/>
                </Grid>
                <Grid Margin="5" Width="100">
                    <Button x:Name="BtnDeleteSupply" Content="🗑 Удалить" 
            Click="DeleteSupply_Click" Height="35" IsEnabled="False"/>
                    <Border x:Name="BtnDeleteSupplyOverlay" Background="Transparent" 
            Visibility="Collapsed" ToolTip=""/>
                </Grid>
                <Button Content="Очистить" Click="ClearForm_Click" Width="90" Height="35" Margin="3"/>
            </StackPanel>

            <StackPanel x:Name="NewSupplyModeButtons" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="BtnSaveNewSupply" Content="💾 Оформить поставку" Click="SaveNewSupply_Click" 
                        Width="150" Margin="5" Height="35" Cursor="Hand"
                        IsEnabled="False"
                        Background="{DynamicResource SuccessBrush}" Foreground="White" FontWeight="Bold"/>
                <Button Content="↩ Отмена" Click="CancelNewSupply_Click" Width="100" Margin="5" Height="35" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <!-- Панель итого для режима создания -->
        <Border x:Name="NewSupplyTotalPanel" Grid.Row="2" Margin="0,15,170,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left" Visibility="Collapsed"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtNewSupplyTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Панель общей суммы поставок -->
        <Border x:Name="GrandTotalPanel" Grid.Row="2" Margin="0,15,0,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰 Общая сумма поставок: " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtGrandTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>