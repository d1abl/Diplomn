<Page x:Class="Diplomn.Pages.CurrentEmployeeEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplomn.Pages"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d"
      Title="Редактирование профиля">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с фото и ФИО -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Border BorderBrush="#E0E0E0" BorderThickness="2" 
                        Width="150" Height="150" CornerRadius="65"
                        Margin="10" Cursor="Hand"
                        MouseLeftButtonDown="SelectPhoto_Click">
                    <Image x:Name="EmployeeImage"
                           Source="/Photos/istockavatar.png"
                           Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="73 73" RadiusX="75" RadiusY="75"/>
                        </Image.Clip>
                    </Image>
                </Border>
                <TextBlock Text="Нажмите для смены фото" 
                          FontSize="10" Foreground="Gray" 
                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0">
                    <TextBlock Text="Фамилия:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtLastName"/>

                    <TextBlock Text="Имя:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtFirstName"/>

                    <TextBlock Text="Отчество:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtMiddleName"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Width="2" Background="#E0E0E0" Margin="10,0"/>

        <!-- Правая панель: дополнительная информация -->
        <Grid Grid.Column="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0">
                    <TextBlock Text="Редактирование данных" 
                              FontWeight="Bold" FontSize="16" 
                              Margin="0,0,0,20"/>

                    <TextBlock Text="Телефон:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtPhone" Height="30"/>

                    <TextBlock Text="Должность:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtEmployeePosition" Height="30" 
                            IsReadOnly="True" Background="#F5F5F5"/>

                    <TextBlock Text="Логин:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtLogin" Height="30" 
                            IsReadOnly="True" Background="#F5F5F5"/>

                    <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
                    <PasswordBox x:Name="PassBox" Height="30"/>

                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Right" 
                               Margin="0,20,0,0">
                        <Button Content="💾 Сохранить изменения" 
                               Click="Update_Click" 
                               FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>