<Page x:Class="Diplomn.Pages.CurrentEmployeeEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplomn.Pages"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d"
      Title="CurrentEmployeeEditPage">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            
            <Image Source="/Photos/istockphoto.jpg" Grid.Row="0" Grid.Column="0" Height="100" Width="100" HorizontalAlignment="Left" Margin="10">
                <Image.Clip>
                    <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                </Image.Clip>
            </Image>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Фамилия:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtLastName" Height="30"/>

                    <TextBlock Text="Имя:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtFirstName" Height="30"/>

                    <TextBlock Text="Отчество:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtMiddleName" Height="30"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Width="2" Background="#E0E0E0" Margin="10,0"/>

        <Grid Grid.Column="3" >
            <!-- Правая панель: форма редактирования -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" >
                <StackPanel>
                    <TextBlock Text="Редактирование данных" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                    <TextBlock Text="Телефон:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtPhone" Height="30"/>

                    <TextBlock Text="Должность:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtEmployeePosition" Height="30" IsReadOnly="True" Background="#F0F0F0"/>

                    <TextBlock Text="Логин:" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtLogin" Height="30" IsReadOnly="True" Background="#F0F0F0"/>

                    <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
                    <PasswordBox x:Name="PassBox" Height="30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <!--<Button Content="➕ Добавить" Click="Add_Click" Width="100" Margin="5"/>-->
                        <Button Content="💾 Обновить" Click="Update_Click" Width="100" Margin="5"/>
                        <!--<Button Content="🗑 Удалить" Click="Delete_Click" Width="100" Margin="5"/>-->
                        <!--<Button Content="❌ Очистить" Click="ClearForm_Click" Width="100" Margin="5"/>-->
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
