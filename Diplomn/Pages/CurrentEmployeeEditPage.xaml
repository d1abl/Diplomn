<Page x:Class="Diplomn.Pages.CurrentEmployeeEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="Редактирование профиля">

    <Page.Resources>
        <addons:PhoneNumberConverter x:Key="PhoneNumberConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Редактирование профиля" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Изменение личных данных" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель с фото и ФИО -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" 
                            Width="150" Height="150" CornerRadius="75"
                            Cursor="Hand" MouseLeftButtonDown="SelectPhoto_Click">
                        <Image x:Name="EmployeeImage" Source="/Photos/istockavatar.png" Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <TextBlock Text="Нажмите для смены фото" FontSize="10" Opacity="0.6" 
                              HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
                    <TextBlock Text="Фамилия *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLastName" Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Имя *" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtFirstName" Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Отчество" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtMiddleName" Height="30" Margin="0,0,0,15"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="15,0"/>

            <!-- Правая панель -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0">
                    <TextBlock Text="Дополнительная информация" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                    <TextBlock Text="Телефон" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPhone" Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Должность" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtEmployeePosition" Height="30" Margin="0,0,0,15"
                             IsReadOnly="True" Background="{DynamicResource BorderBrush}" Opacity="0.3"/>

                    <TextBlock Text="Логин" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLogin" Height="30" Margin="0,0,0,15"
                             IsReadOnly="True" Background="{DynamicResource BorderBrush}" Opacity="0.3"/>

                    <TextBlock Text="Пароль" FontSize="11" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="PassBox" Height="30" Margin="0,0,0,15"/>

                    <Border Padding="10" CornerRadius="4" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить изменения" Click="Update_Click" 
                                Height="40" FontSize="14" FontWeight="Bold"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>