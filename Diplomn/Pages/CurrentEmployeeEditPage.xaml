<Page x:Class="Diplomn.Pages.CurrentEmployeeEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:addons="clr-namespace:Diplomn.Addons"
      Title="Редактирование профиля"
      Width="650"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" 
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Редактирование профиля" 
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Изменение личных данных" 
                           FontSize="16" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: фото -->
            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                <Border Width="150" Height="150" CornerRadius="75"
                        BorderBrush="{DynamicResource AccentBrush}" 
                        BorderThickness="2"
                        Cursor="Hand" 
                        MouseLeftButtonDown="SelectPhoto_Click"
                        HorizontalAlignment="Center">
                    <Image x:Name="EmployeeImage" 
                           Source="/Photos/istockavatar.png" 
                           Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75"/>
                        </Image.Clip>
                    </Image>
                </Border>
                <TextBlock Text="Нажмите для смены фото" 
                           FontSize="14" Opacity="0.6" 
                           HorizontalAlignment="Center" 
                           Margin="0,10,0,15"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Личные данные" 
                               FontWeight="Bold" FontSize="14" 
                               Margin="0,0,0,5"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                <!-- Фамилия -->
                <TextBlock Text="Фамилия *" FontSize="19" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLastName" Height="34" Margin="0,0,0,14" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите фамилию"/>

                <!-- Имя -->
                <TextBlock Text="Имя *" FontSize="19" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtFirstName" Height="34" Margin="0,0,0,14" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите имя"/>

                <!-- Отчество -->
                <TextBlock Text="Отчество" FontSize="19" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtMiddleName" Height="34" Margin="0,0,0,14" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="Введите отчество (необязательно)"/>
            </StackPanel>

            <!-- Разделитель -->
            <Border Grid.Column="1" Width="1" 
                    Background="{DynamicResource BorderBrush}" 
                    Opacity="0.2" Margin="0,0,30,0"/>

            <!-- Правая панель: Контакты и доступ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Контакты и доступ" 
                               FontWeight="Bold" FontSize="14" 
                               Margin="0,0,0,20"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Телефон -->
                    <TextBlock Text="Телефон" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="34" Margin="0,0,0,14" FontSize="19"
                             addons:PlaceholderBehavior.PlaceholderText="+79001234567"/>

                    <!-- Должность (только чтение) -->
                    <TextBlock Text="Должность" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmployeePosition" Height="34" Margin="0,0,0,14" FontSize="19"
                             IsReadOnly="True" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"
                             addons:PlaceholderBehavior.PlaceholderText="Должность"/>

                    <!-- Логин (только чтение) -->
                    <TextBlock Text="Логин" FontSize="19" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLogin" Height="34" Margin="0,0,0,14" FontSize="19"
                             IsReadOnly="True" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"
                             addons:PlaceholderBehavior.PlaceholderText="Логин"/>

                    <!-- Пароль -->
                    <TextBlock Text="Новый пароль" FontSize="19" Margin="0,0,0,4"/>
                    <TextBlock Text="Оставьте пустым, если не хотите менять" 
                               FontSize="12" Opacity="0.5" Margin="0,0,0,4"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <PasswordBox x:Name="PassBox" Height="34" Margin="0,0,0,20"
                                addons:PlaceholderBehavior.HasEye="True" FontSize="19"
                                addons:PlaceholderBehavior.PlaceholderText="Введите новый пароль"/>

                    <!-- Кнопка сохранения -->
                    <Button Content="💾 Сохранить изменения" 
                            Click="Update_Click" 
                            Height="42" FontSize="15" FontWeight="Bold"
                            Background="{DynamicResource BackgroundBrush}" 
                            Foreground="{DynamicResource ForegroundBrush}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"/>
                    <Border x:Name="SuccessBorder" 
                        Background="{DynamicResource SuccessBrush}" 
                        CornerRadius="4" 
                        Padding="12,10" 
                        Visibility="Collapsed">
                        <TextBlock x:Name="SuccessText" 
                               Foreground="{DynamicResource ForegroundBrush}" 
                               HorizontalAlignment="Center" 
                               TextWrapping="Wrap"
                               FontSize="13"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>