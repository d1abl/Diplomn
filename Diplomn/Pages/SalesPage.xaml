<Page x:Class="Diplomn.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="SalesPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление продажами" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: таблица продаж -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Список продаж" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <DataGrid x:Name="DataGridSales" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="300" 
                          Margin="0,5,0,0"
                          SelectionChanged="DataGridSales_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код чека" Binding="{Binding Код_чека}" Width="80"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Дата_продажи, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="160"/>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding Сотрудники.Фамилия}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="1" Width="2" Background="#E0E0E0" Margin="10,0"/>

            <!-- Правая панель: информация о продаже -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Информация о продаже" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                <TextBlock Text="Код чека:" Margin="0,10,0,5"/>
                <TextBox x:Name="TxtSaleId" IsReadOnly="True" Background="#F0F0F0" Height="30"/>

                <TextBlock Text="Дата продажи:" Margin="0,10,0,5"/>
                <TextBox x:Name="TxtSaleDate" IsReadOnly="True" Background="#F0F0F0" Height="30"/>

                <TextBlock Text="Сотрудник:" Margin="0,10,0,5"/>
                <TextBox x:Name="TxtEmployee" IsReadOnly="True" Background="#F0F0F0" Height="30"/>

                <TextBlock Text="Состав чека:" Margin="0,10,0,5" FontWeight="Bold"/>
                <DataGrid x:Name="DataGridSaleItems" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Height="150"
                          Margin="0,5,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding Товар}" Width="150"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="60"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} ₽}" Width="80"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtTotal" FontWeight="Bold" Foreground="#F44336" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="➕ Новая продажа" Click="NewSale_Click" Width="130" Margin="5"/>
            <Button Content="📋 Состав чека" Click="ViewSaleComposition_Click" Width="120" Margin="5"/>
            <Button Content="🗑 Удалить" Click="DeleteSale_Click" Width="100" Margin="5"/>
            <Button Content="🔄 Обновить" Click="Refresh_Click" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>