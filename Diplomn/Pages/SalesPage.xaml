<Page x:Class="Diplomn.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d" 
      Title="SalesPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление продажами" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: карточки продаж -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск и кнопки -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по коду чека или сотруднику (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"
                                 addons:PlaceholderBehavior.PlaceholderText="Поиск по коду чека или сотруднику"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Фильтр по дате -->
                <Expander Grid.Row="1" Header="📅 Фильтр по дате" IsExpanded="False" Margin="0,0,0,8">
                    <Border Padding="8">
                        <StackPanel>
                            <TextBlock Text="Дата от" FontSize="11" Margin="0,0,0,3"/>
                            <DatePicker x:Name="DateFrom" Height="30" Margin="0,0,0,10"/>
                            <TextBlock Text="Дата до" FontSize="11" Margin="0,0,0,3"/>
                            <DatePicker x:Name="DateTo" Height="30"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Карточки продаж -->
                <ListView Grid.Row="2" x:Name="ListViewSales"
                          SelectionMode="Single"
                          SelectionChanged="ListViewSales_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="5"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" 
                                    Width="220"
                                    Height="140"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding ReceiptDisplay}" 
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}"/>

                                    <TextBlock Text="{Binding DateDisplay}" 
                                               Margin="0,8,0,0"
                                               FontSize="12"/>

                                    <TextBlock Text="{Binding EmployeeDisplay}" 
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding TotalDisplay}" 
                                               Margin="0,8,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая панель: информация о продаже -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Информация о продаже" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Код чека:" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtSaleId" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                         addons:PlaceholderBehavior.PlaceholderText="Код чека"/>

                <TextBlock Text="Дата продажи:" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtSaleDate" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                         addons:PlaceholderBehavior.PlaceholderText="Дата продажи"/>

                <TextBlock Text="Сотрудник:" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtEmployee" IsReadOnly="True" Height="30" Margin="0,0,0,15"
                         addons:PlaceholderBehavior.PlaceholderText="Сотрудник"/>

                <TextBlock Text="Состав чека:" FontWeight="Bold" Margin="0,0,0,8"/>

                <!-- Список товаров в чеке -->
                <ListView x:Name="ListViewSaleItems"
                          SelectionMode="Single"
                          Height="200"
                          Margin="0,0,0,15"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="16" 
                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="➕ Новая продажа" Click="NewSale_Click" Width="130" Margin="5" Height="35"/>
            <Button Content="🗑 Удалить" Click="DeleteSale_Click" Width="100" Margin="5" Height="35"/>
            <Button Content="🔄 Обновить" Click="Refresh_Click" Width="100" Margin="5" Height="35"/>
        </StackPanel>
    </Grid>
</Page>