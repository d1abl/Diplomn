<Page x:Class="Diplomn.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d" 
      Title="Продажи"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="25 15 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="PageModeText" Text="Управление продажами" FontSize="13" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Режим просмотра продаж -->
            <Grid x:Name="SalesViewGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель: карточки продаж -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поиск и кнопки -->
                    <Border Grid.Row="0" Padding="5" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Height="32" 
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск по товару в чеке..."
                                     KeyDown="TxtSearch_KeyDown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                                <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                                <Button Content="📊" Width="36" Height="32" Click="SaveReport_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Фильтры -->
                    <Expander Grid.Row="1" Header="⚙ Фильтры и сортировка" IsExpanded="False" Margin="0,0,0,8"
                              Foreground="{DynamicResource ForegroundBrush}">
                        <Border Padding="8" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel>
                                <!-- Фильтр по дате -->
                                <TextBlock Text="Дата продажи" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="От" FontSize="10" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <DatePicker x:Name="DateFrom" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="До" FontSize="10" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <DatePicker x:Name="DateTo" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Фильтр по сотруднику -->
                                <TextBlock Text="Сотрудник" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <ComboBox x:Name="CmbEmployee" Height="28" Margin="0,0,0,10" 
                                          Style="{DynamicResource PlaceholderComboBox}"
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Код_сотрудника"/>

                                <!-- Сортировка -->
                                <TextBlock Text="Сортировка" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <StackPanel Margin="0,0,0,5">
                                    <RadioButton x:Name="RbSortByDate" Content="По дате (новые сначала)" 
                                                 IsChecked="True" Margin="0,2,0,2" FontSize="11"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByDateAsc" Content="По дате (старые сначала)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByAmount" Content="По сумме (по убыванию)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 Checked="SortChanged"/>
                                    <RadioButton x:Name="RbSortByAmountAsc" Content="По сумме (по возрастанию)" 
                                                 Margin="0,2,0,2" FontSize="11"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 Checked="SortChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- Карточки продаж -->
                    <ListView Grid.Row="2" x:Name="ListViewSales"
                              SelectionMode="Single"
                              SelectionChanged="ListViewSales_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0" 
                                        Width="130"
                                        Height="100"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SaleDisplay}" 
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"/>

                                        <TextBlock Text="{Binding DateDisplay}" 
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>

                                        <TextBlock Text="{Binding EmployeeDisplay}" 
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>

                                        <TextBlock Text="{Binding TotalDisplay}" 
                                                   Margin="0,6,0,0"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель: информация о продаже -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,20,0">
                        <TextBlock Text="Информация о продаже" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                                   Foreground="{DynamicResource ForegroundBrush}"/>

                        <TextBlock Text="Код чека:" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBox x:Name="TxtSaleId" IsReadOnly="True" Height="32" Margin="0,0,0,12"
                                 addons:PlaceholderBehavior.PlaceholderText="Код чека" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Дата продажи:" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBox x:Name="TxtSaleDate" IsReadOnly="True" Height="32" Margin="0,0,0,12"
                                 addons:PlaceholderBehavior.PlaceholderText="Дата продажи" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Сотрудник:" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBox x:Name="TxtEmployee" IsReadOnly="True" Height="32" Margin="0,0,0,15"
                                 addons:PlaceholderBehavior.PlaceholderText="Сотрудник" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Состав чека:" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <!-- Список товаров в чеке -->
                            <ListView x:Name="ListViewSaleItems"
                                  SelectionMode="Single"
                                      MinHeight="200"
                                      MaxHeight="520"
                                  Margin="0,0,0,15"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="40" Height="40" 
                                                    CornerRadius="3"
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0">
                                                    <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                    <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="11" Opacity="0.7"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                        <StackPanel x:Name="TotalPanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                            <TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="16" 
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Режим создания новой продажи -->
            <Grid x:Name="NewSaleGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель - каталог товаров -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Каталог товаров" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Поиск по товарам -->
                    <Border Grid.Row="1" Padding="5" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtProductSearch" Height="32" 
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию товара..."
                                     KeyDown="TxtProductSearch_KeyDown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="36" Height="32" Click="ApplyProductFilters_Click"/>
                                <Button Content="✕" Width="36" Height="32" Click="ClearProductFilters_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Список товаров карточками -->
                    <ListView Grid.Row="2" x:Name="ListViewProducts"
                              SelectionMode="Single"
                              SelectionChanged="ListViewProducts_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" 
                                        Width="200"
                                        Height="280"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Width="100" Height="100" 
                                                CornerRadius="4"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,8">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Наименование}" 
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Наименование}"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   Opacity="0.7"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding PriceDisplay}" 
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding StockStatus}" 
                                                   FontSize="11"
                                                   Margin="0,2,0,8"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>

                                        <TextBlock Text="Кол-во:" FontSize="11" Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtItemQuantity"
                                                     Text="1"
                                                     Width="55" 
                                                     Height="24"
                                                     TextAlignment="Center"
                                                     Margin="0,0,5,0"
                                                     PreviewTextInput="TxtItemQuantity_PreviewTextInput"/>
                                            <Slider Grid.Column="1" 
                                                    x:Name="QuantitySlider"
                                                    Width="100"
                                                    Minimum="0" 
                                                    Maximum="100" 
                                                    Value="0"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="QuantitySlider_ValueChanged"
                                                    Tag="{Binding}"/>
                                        </Grid>

                                        <Button x:Name="BtnAddToSale" 
                                                Content="➕ В чек" 
                                                Click="AddToSaleItem_Click"
                                                Height="28"
                                                Margin="0,5,0,0"
                                                FontSize="11"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель - корзина -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Товары в чеке" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"
                               Foreground="{DynamicResource ForegroundBrush}"/>

                    <ListView Grid.Row="1" x:Name="ListViewNewSaleItems"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" 
                                                CornerRadius="3"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="11" Opacity="0.7"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Button Grid.Column="3" Content="✕" Width="28" Height="24" Margin="5,0,0,0"
                                                Click="RemoveNewSaleItem_Click" Tag="{Binding}"
                                                ToolTip="Удалить позицию"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Нижняя панель с кнопками -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <StackPanel x:Name="ViewModeButtons" Orientation="Horizontal"/>
            <StackPanel x:Name="NewSaleModeButtons" Orientation="Horizontal" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Панель итого для режима создания -->
        <Border x:Name="NewSaleTotalPanel" Grid.Row="2" Margin="0,15,170,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left" Visibility="Collapsed"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="TxtNewSaleTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Панель общей суммы продаж -->
        <Border x:Name="GrandTotalPanel" Grid.Row="2" Margin="0,15,0,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰 Общая сумма продаж: " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="TxtGrandTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>