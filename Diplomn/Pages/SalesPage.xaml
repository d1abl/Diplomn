<Page x:Class="Diplomn.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SalesPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Продажи" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Управление продажами и чеками" FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск и кнопки -->
                <Border Grid.Row="0" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по коду чека (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32"
                                    Click="ApplyFilters_Click" ToolTip="Применить фильтры"/>
                            <Button Content="✕" Width="40" Height="32"
                                    Click="ClearFilters_Click" ToolTip="Сбросить фильтры"/>
                            <Button Content="📊" Width="40" Height="32"
                                    Click="SaveReport_Click" ToolTip="Сохранить отчет"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Фильтры -->
                <Expander Grid.Row="1" Header="⚙ Фильтры по дате" IsExpanded="False" Margin="0,0,0,8">
                    <Border Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Дата с:" FontSize="11" Margin="0,0,0,3"/>
                                <DatePicker x:Name="DateFrom" Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Дата по:" FontSize="11" Margin="0,0,0,3"/>
                                <DatePicker x:Name="DateTo" Height="30"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <!-- Таблица -->
                <DataGrid Grid.Row="2" x:Name="DataGridSales" 
                          SelectionChanged="DataGridSales_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Чек №" Binding="{Binding Код_чека}" Width="70"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Дата_продажи, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding Сотрудники.Фамилия}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая часть -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Детали продажи" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="Код чека" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSaleId" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Дата продажи" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSaleDate" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Сотрудник" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtEmployee" IsReadOnly="True" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Состав чека" FontWeight="Bold" FontSize="13" Margin="0,10,0,5"/>
                    <DataGrid x:Name="DataGridSaleItems" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Товар}" Width="140"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="60"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} ₽}" Width="90"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource BorderBrush}" Padding="10" CornerRadius="4" 
                            Margin="0,10,0,0" Opacity="0.9">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource BackgroundBrush}"/>
                            <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource BackgroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Новая продажа" Click="NewSale_Click" Width="110" Margin="3"/>
                        <Button Content="Состав чека" Click="ViewSaleComposition_Click" Width="100" Margin="3"/>
                        <Button Content="Удалить" Click="DeleteSale_Click" Width="90" Margin="3"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>