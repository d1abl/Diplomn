<Page x:Class="Diplomn.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:addons="clr-namespace:Diplomn.Addons"
      mc:Ignorable="d" 
      Title="Продажи"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="25 15 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="PageModeText" Text="Управление продажами" FontSize="16" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Режим просмотра продаж -->
            <Grid x:Name="SalesViewGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель: карточки продаж -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поиск и кнопки -->
                    <Border Grid.Row="0" Padding="5" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Height="32" FontSize="19" 
                                     addons:PlaceholderBehavior.PlaceholderText="Поиск по товару в чеке..."
                                     KeyDown="TxtSearch_KeyDown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="36" Height="32" Click="ApplyFilters_Click"/>
                                <Button Content="✕" Width="36" Height="32" Click="ClearFilters_Click" Margin="4,0,0,0"/>
                                <Button Content="📊" Width="36" Height="32" Click="SaveReport_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Фильтры -->
                    <Expander Grid.Row="1" Header="⚙ Фильтры и сортировка" IsExpanded="False" Margin="0,-10,0,10"
          Foreground="{DynamicResource ForegroundBrush}">
                        <Border Padding="8" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel>
                                <StackPanel Margin="0,5,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Фильтр по дате -->
                                        <TextBlock Grid.Column="0" Text="Дата поставки (от — до)" FontSize="18" Margin="0,-15,0,50"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker x:Name="DateFrom" Height="35"/>
                                            <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="6,0"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                                            <DatePicker Grid.Column="2" x:Name="DateTo" Height="35"/>
                                        </Grid>

                                        <!-- Сортировка -->
                                        <TextBlock Grid.Column="1" Text="Сортировка" FontSize="18" FontWeight="Bold" Margin="10,-15,0,0"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid Grid.Column="1" Margin="10 0 -10 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BtnSortByDate" Height="35" CornerRadius="4" Padding="6,3" Margin="0,0,0,0" Grid.Column="0"
                            Background="{DynamicResource BackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonDown="ToggleDateSort_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📅 По дате" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="DateSortArrow" Text="↑" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="BtnSortByAmount" Height="35" CornerRadius="4" Padding="6,3" Margin="10,0,0,0" Grid.Column="1"
                            Background="{DynamicResource BackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonDown="ToggleAmountSort_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💰 По сумме" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="AmountSortArrow" Text="" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </StackPanel>


                                <!-- Дата и Сотрудник в одной строке -->
                                <Grid Margin="-10,0,0,10">

                                    <!-- Фильтр по сотруднику -->
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Сотрудник" FontSize="18" Margin="0,0,0,4"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBox x:Name="TxtSearchEmployee" Height="28"
                             addons:PlaceholderBehavior.PlaceholderText="Поиск сотрудника..."
                             TextChanged="FilterEmployees_TextChanged"/>
                                        <UniformGrid x:Name="PanelEmployees" Columns="3" 
                                 HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>
                    
                    <!-- Карточки продаж -->
                    <ListView Grid.Row="2" x:Name="ListViewSales"
                              SelectionMode="Single"
                              SelectionChanged="ListViewSales_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0" 
                                        Width="205"
                                        Height="120"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SaleDisplay}" 
                                                   FontWeight="Bold"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}"/>

                                        <TextBlock Text="{Binding DateDisplay}" 
                                                   Margin="0,6,0,0"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>

                                        <TextBlock Text="{Binding EmployeeDisplay}" 
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>

                                        <TextBlock Text="{Binding TotalDisplay}" 
                                                   Margin="0,6,0,0"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель: информация о продаже -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,20,0">
                        <TextBlock Text="Информация о продаже" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                                   Foreground="{DynamicResource ForegroundBrush}"/>

                        <TextBlock Text="Код чека:" FontSize="19" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBox x:Name="TxtSaleId" IsReadOnly="True" Height="32" Margin="0,0,0,12" FontSize="19"
                                 addons:PlaceholderBehavior.PlaceholderText="Код чека" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Дата продажи:" FontSize="19" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBox x:Name="TxtSaleDate" IsReadOnly="True" Height="32" Margin="0,0,0,12" FontSize="19"
                                 addons:PlaceholderBehavior.PlaceholderText="Дата продажи" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Сотрудник:" FontSize="19" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBox x:Name="TxtEmployee" IsReadOnly="True" Height="32" Margin="0,0,0,15" FontSize="19"
                                 addons:PlaceholderBehavior.PlaceholderText="Сотрудник" Focusable="False" Cursor="Arrow" Opacity="0.4" ToolTip="Заполняется автоматически"/>

                        <TextBlock Text="Состав чека:" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <!-- Список товаров в чеке -->
                            <ListView x:Name="ListViewSaleItems"
                                  SelectionMode="Single"
                                      MinHeight="200"
                                      MaxHeight="485"
                                  Margin="0,0,0,15"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="40" Height="40" 
                                                    CornerRadius="3"
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0">
                                                    <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="19"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="18" Opacity="0.7"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" FontSize="18"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                                    </StackPanel>
                                                    
                                                </StackPanel>
                                                
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                        </ScrollViewer>
                        <StackPanel x:Name="TotalPanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                            <TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="20"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="20" 
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Режим создания новой продажи -->
            <Grid x:Name="NewSaleGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель - каталог товаров -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Каталог товаров" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"/>

                    <!-- Поиск по товарам -->
                    <Border Grid.Row="1" Padding="5" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtProductSearch" Height="32" 
                         addons:PlaceholderBehavior.PlaceholderText="Поиск по наименованию товара..."
                         KeyDown="TxtProductSearch_KeyDown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <Button Content="🔍" Width="36" Height="32" Click="ApplyProductFilters_Click"/>
                                <Button Content="✕" Width="36" Height="32" Click="ClearProductFilters_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Фильтры каталога -->
                    <Expander Grid.Row="2" Header="⚙ Фильтры каталога" IsExpanded="False" Margin="0,0,0,8"
                  Foreground="{DynamicResource ForegroundBrush}">
                        <Border Padding="8" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="0 -10 0 0">
                                <!-- В наличии и Цена -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- В наличии -->
                                    <CheckBox x:Name="ChkNewSaleInStock" Content="В наличии" Margin="0 10 0 0" 
                                  VerticalAlignment="Center" FontSize="19"
                                  Foreground="{DynamicResource ForegroundBrush}"/>

                                    <!-- Цена -->
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="Цена (от — до)" FontSize="18" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtNewSalePriceMin" Height="28"
                                         addons:PlaceholderBehavior.PlaceholderText="От"/>
                                            <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="6,0"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBox Grid.Column="2" x:Name="TxtNewSalePriceMax" Height="28"
                                         addons:PlaceholderBehavior.PlaceholderText="До"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Категории, бренды и т.д. -->
                                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Категории -->
                                        <Expander Header="Категории" IsExpanded="False" Margin="0,0,0,5"
                                      Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSaleSearchCategories" Height="28" Margin="0,0,0,5"
                                             addons:PlaceholderBehavior.PlaceholderText="Поиск категории..."
                                             TextChanged="NewSaleFilterCategories_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSaleCategories" Columns="4" 
                                                 HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>

                                        <!-- Бренды -->
                                        <Expander Header="Бренды" IsExpanded="False" Margin="0,0,0,5"
                                      Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSaleSearchBrands" Height="28" Margin="0,0,0,5"
                                             addons:PlaceholderBehavior.PlaceholderText="Поиск бренда..."
                                             TextChanged="NewSaleFilterBrands_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSaleBrands" Columns="4" 
                                                 HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>

                                        <!-- Производители -->
                                        <Expander Header="Производители" IsExpanded="False" Margin="0,0,0,5"
                                      Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSaleSearchManufacturers" Height="28" Margin="0,0,0,5"
                                             addons:PlaceholderBehavior.PlaceholderText="Поиск производителя..."
                                             TextChanged="NewSaleFilterManufacturers_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSaleManufacturers" Columns="4" 
                                                 HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>

                                        <!-- Материалы -->
                                        <Expander Header="Материалы" IsExpanded="False" Margin="0,0,0,5"
                                      Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSaleSearchMaterials" Height="28" Margin="0,0,0,5"
                                             addons:PlaceholderBehavior.PlaceholderText="Поиск материала..."
                                             TextChanged="NewSaleFilterMaterials_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSaleMaterials" Columns="4" 
                                                 HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>

                                        <!-- Фасовка -->
                                        <Expander Header="Фасовка" IsExpanded="False"
                                      Foreground="{DynamicResource ForegroundBrush}">
                                            <StackPanel>
                                                <TextBox x:Name="TxtNewSaleSearchPacking" Height="28" Margin="0,0,0,5"
                                             addons:PlaceholderBehavior.PlaceholderText="Поиск фасовки..."
                                             TextChanged="NewSaleFilterPacking_TextChanged"/>
                                                <UniformGrid x:Name="PanelNewSalePacking" Columns="4" 
                                                 HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- Список товаров карточками -->
                    <ListView Grid.Row="3" x:Name="ListViewProducts"
                  SelectionMode="Single"
                  SelectionChanged="ListViewProducts_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" 
                            Width="200"
                            Height="320"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Width="100" Height="100" 
                                    CornerRadius="4"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Наименование}" 
                                       FontWeight="Bold"
                                       FontSize="20"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Наименование}"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource ForegroundBrush}"/>                                        
                                        <TextBlock Text="{Binding PriceDisplay}" 
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                       FontSize="16"
                                       Margin="0,2,0,0"
                                       Opacity="0.7"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding StockStatus}" 
                                       FontSize="14"
                                       Margin="0,2,0,8"
                                       Foreground="{DynamicResource ForegroundBrush}"/>

                                        <TextBlock Text="Кол-во:" FontSize="18" Margin="0,0,0,3"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtItemQuantity"
                                         Text="1"
                                         Width="55" 
                                         Height="30"
                                         TextAlignment="Center"
                                         Margin="0,0,5,0"
                                         PreviewTextInput="TxtItemQuantity_PreviewTextInput"/>
                                            <Slider Grid.Column="1" Margin="0 7 0 0"
                                        x:Name="QuantitySlider"
                                        Width="100"
                                        Minimum="0" 
                                        Maximum="100" 
                                        Value="0"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="QuantitySlider_ValueChanged"
                                        Tag="{Binding}"/>
                                        </Grid>

                                        <Button x:Name="BtnAddToSale" 
                                    Content="➕ В чек" 
                                    Click="AddToSaleItem_Click"
                                    Height="28"
                                    Margin="0,5,0,0"
                                    FontSize="18"
                                    Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

                <!-- Правая панель - корзина -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Товары в чеке" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"/>

                    <ListView Grid.Row="1" x:Name="ListViewNewSaleItems"
                  SelectionMode="Single"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" 
                                    CornerRadius="3"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    Margin="0,0,10,0">
                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Товар}" FontWeight="Bold" FontSize="19"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="18" Opacity="0.7"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" FontSize="18"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            </StackPanel>
                                            
                                        </StackPanel>
                                        
                                        <Button Grid.Column="3" Content="✕" Width="28" Height="24" Margin="5,0,0,0"
                                    Click="RemoveNewSaleItem_Click" Tag="{Binding}"
                                    ToolTip="Удалить позицию"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Нижняя панель с кнопками -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">            
            <StackPanel x:Name="ViewModeButtons" Orientation="Horizontal"/>
            <StackPanel x:Name="NewSaleModeButtons" Orientation="Horizontal" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Панель итого для режима создания -->
        <Border x:Name="NewSaleTotalPanel" Grid.Row="2" Margin="0,15,170,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left" Visibility="Collapsed"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="TxtNewSaleTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Панель общей суммы продаж -->
        <Border x:Name="GrandTotalPanel" Grid.Row="2" Margin="0,15,0,0" Padding="10" 
                CornerRadius="4" HorizontalAlignment="Left"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰 Общая сумма продаж: " FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="TxtGrandTotal" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>