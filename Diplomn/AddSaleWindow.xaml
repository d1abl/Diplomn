<Window x:Class="Diplomn.AddSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая продажа" Height="550" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <TextBlock Text="Оформление продажи" FontSize="18" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - каталог товаров -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Каталог товаров" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                <!-- Поиск и фильтры -->
                <Border Grid.Row="1" Padding="5" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="32" 
                                 ToolTip="Поиск по наименованию (Enter для поиска)"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="🔍" Width="40" Height="32" Click="ApplyFilters_Click"/>
                            <Button Content="✕" Width="40" Height="32" Click="ClearFilters_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Grid.Row="2" Header="⚙ Фильтры" IsExpanded="False" Margin="0,0,0,8">
                    <Border Padding="8">
                        <StackPanel>
                            <CheckBox x:Name="ChkInStock" Content="Только в наличии" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Цена (от - до)" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtPriceMin" Width="70" Height="28"/>
                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="TxtPriceMax" Width="70" Height="28"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Количество (от - до)" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtQtyMin" Width="70" Height="28"/>
                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="TxtQtyMax" Width="70" Height="28"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Список товаров карточками -->
                <ListView Grid.Row="3" x:Name="ListViewProducts"
                          SelectionMode="Single"
                          SelectionChanged="ListViewProducts_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="5"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" 
                                    Width="180"
                                    Height="220"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Border Width="100" Height="100" 
                                            CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8">
                                        <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Наименование}" 
                                               FontWeight="Bold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Наименование}"
                                               TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding CategoryName}" 
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               Opacity="0.7"/>
                                    <TextBlock Text="{Binding PriceDisplay}" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding QuantityDisplay}" 
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Width="2" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="10,0"/>

            <!-- Правая панель - добавление товаров и корзина -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Добавление товара" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Padding="10" Margin="0,0,0,15"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Выбранный товар:" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSelectedProduct" IsReadOnly="True" Height="30" Margin="0,0,0,10"
                                 Background="#2A2A2A"/>

                        <TextBlock Text="Цена продажи" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtPrice" Height="30" Margin="0,0,0,10" IsReadOnly="True"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Количество" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtQuantity" Text="1" Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Доступно" FontSize="11" Margin="0,0,0,3"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                        CornerRadius="3" Padding="8,5" Height="30" MinWidth="60">
                                    <TextBlock x:Name="TxtAvailable" VerticalAlignment="Center" 
                                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Button Content="➕ Добавить в чек" Click="AddToSale_Click" Height="35"
                                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Товары в чеке" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <ListView Grid.Row="1" x:Name="ListViewSaleItems"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Товары.Наименование}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding PriceQuantityDisplay}" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Сумма, StringFormat={}{0:N2} ₽}" 
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                                        <Button Grid.Column="2" Content="✕" Width="30" Height="25" Margin="5,0,0,0"
                                                Click="RemoveItem_Click" Tag="{Binding}"
                                                ToolTip="Удалить позицию"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotal" FontSize="18" FontWeight="Bold" 
                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Оформить продажу" Click="SaveSale_Click" 
                        Height="38" Width="140" Margin="5,0"
                        Background="{DynamicResource SuccessBrush}" Foreground="White" FontWeight="Bold"/>

                <Button Grid.Column="3" Content="Отмена" Click="Cancel_Click" 
                        Height="38" Width="100" Margin="5,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>