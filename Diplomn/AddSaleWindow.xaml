<Window x:Class="Diplomn.AddSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая продажа" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Оформление продажи" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Выберите товар:" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbProduct" Height="35" Margin="0,0,0,5"
                          DisplayMemberPath="Наименование" SelectedValuePath="Код_товара"/>

                <TextBlock Text="Количество:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtQuantity" Text="1" Height="30" Margin="0,0,0,5" TextChanged="TxtQuantity_TextChanged"/>

                <TextBlock Text="Цена продажи:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtPrice" Height="30" Margin="0,0,0,5" IsReadOnly="True"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Доступно:" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtAvailable"/>
                </StackPanel>

                <Button Content="➕ Добавить в чек" Click="AddToSale_Click" />
            </StackPanel>

            <DataGrid x:Name="DataGridSaleItems" Grid.Column="1" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Товары.Наименование}" Width="150"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} ₽}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}" Width="80"/> <!---->
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Итого: -->
                <ColumnDefinition Width="Auto"/>
                <!-- Сумма -->
                <ColumnDefinition Width="*"/>
                <!-- Заполнитель (толкает кнопки вправо) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Кнопка "Оформить продажу" -->
                <ColumnDefinition Width="Auto"/>
                <!-- Кнопка "Отмена" -->
            </Grid.ColumnDefinitions>

            <!-- Итого: -->
            <TextBlock Grid.Column="0" 
               Text="Итого: " 
               FontSize="16" 
               FontWeight="Bold" 
               VerticalAlignment="Center"/>

            <!-- Сумма -->
            <TextBlock Grid.Column="1" x:Name="TxtTotal" Margin="5,0,20,0"/>

            <!-- Кнопка "Оформить продажу" -->
            <Button Grid.Column="3" Content="Оформить продажу" Click="SaveSale_Click"/>

            <!-- Кнопка "Отмена" -->
            <Button Grid.Column="4" Content="Отмена" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>