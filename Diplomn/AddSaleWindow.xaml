<Window x:Class="Diplomn.AddSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая продажа" Height="550" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <TextBlock Text="Оформление продажи" FontSize="18" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - добавление товаров -->
            <Border Grid.Column="0" Padding="10" Margin="0,0,10,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Добавление товара" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>

                    <TextBlock Text="Товар" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbProduct" Height="32" Margin="0,0,0,10"
                              DisplayMemberPath="Наименование" SelectedValuePath="Код_товара"/>

                    <TextBlock Text="Цена продажи" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPrice" Height="30" Margin="0,0,0,10" IsReadOnly="True"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Количество" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtQuantity" Text="1" Height="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Доступно" FontSize="11" Margin="0,0,0,3"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                    CornerRadius="3" Padding="8,5" Height="30" MinWidth="60">
                                <TextBlock x:Name="TxtAvailable" VerticalAlignment="Center" 
                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Button Content="➕ Добавить в чек" Click="AddToSale_Click" Height="35"
                            Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Правая панель - список товаров -->
            <Border Grid.Column="1" Padding="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Товары в чеке" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="DataGridSaleItems" AutoGenerateColumns="False" 
                              IsReadOnly="True" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Товары.Наименование}" Width="180"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="70"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} ₽}" Width="100"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}" Width="120"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Width="30" Height="25" 
                                                Click="RemoveItem_Click" Tag="{Binding}"
                                                ToolTip="Удалить позицию"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotal" FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Оформить продажу" Click="SaveSale_Click" 
                        Height="38" Width="140" Margin="5,0"
                        Background="{DynamicResource SuccessBrush}" Foreground="White" FontWeight="Bold"/>

                <Button Grid.Column="3" Content="Отмена" Click="Cancel_Click" 
                        Height="38" Width="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>