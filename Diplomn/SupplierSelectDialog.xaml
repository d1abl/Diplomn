<Window x:Class="Diplomn.SupplierSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор поставщика" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <TextBlock Text="Выберите поставщика" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Поиск -->
        <Border Grid.Row="1" Padding="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch" Height="32" 
                         ToolTip="Поиск по наименованию или ИНН (Enter для поиска)"
                         KeyDown="TxtSearch_KeyDown"
                         TextChanged="TxtSearch_TextChanged"/>
                <Button Grid.Column="1" Content="✕" Width="40" Height="32" Margin="5,0,0,0"
                        Click="ClearSearch_Click" ToolTip="Сбросить поиск"/>
            </Grid>
        </Border>

        <!-- Список поставщиков -->
        <DataGrid Grid.Row="2" x:Name="DataGridSuppliers" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  MouseDoubleClick="DataGridSuppliers_MouseDoubleClick"
                  SelectionChanged="DataGridSuppliers_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование_поставщика}" Width="200"/>
                <DataGridTextColumn Header="ИНН" Binding="{Binding ИНН}" Width="120"/>
                <DataGridTextColumn Header="Контактное лицо" Width="150">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Фамилия_контактного_лица"/>
                            <Binding Path="Имя_контактного_лица"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки -->
        <Border Grid.Row="3" Padding="10" Margin="0,10,0,0" CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtSelectedSupplier" VerticalAlignment="Center" 
                           Opacity="0.7" Text="Поставщик не выбран"/>

                <Button Grid.Column="1" Content="Выбрать" Click="SelectSupplier_Click" 
                        Height="35" Width="100" Margin="5,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold"
                        IsEnabled="False" x:Name="BtnSelect"/>

                <Button Grid.Column="2" Content="Отмена" Click="Cancel_Click" 
                        Height="35" Width="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>