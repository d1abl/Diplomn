<Window x:Class="Diplomn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplomn"
        mc:Ignorable="d"
        Title="HR - Система управления товаром" Height="900" Width="1600">
    <Grid>
        <!-- Grid для MainWondow -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
       
        <!-- Frame для контента (открываются страницы через меню) -->
        <Frame x:Name="MainFrame" 
               Grid.Row="1" 
               Source="Pages/AuthPage.xaml"
               Navigated="MainFrame_Navigated"/>
        
        
        
        <Grid Grid.Row="0" Background="#2196F3"/>
        
        <!-- верхняя панель -->
        <Grid Grid.RowSpan="2" Background="Transparent" VerticalAlignment="Top" ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            
            <!-- Меню -->
            <Border x:Name="VisiblBtn" Cursor="Arrow" Visibility="Collapsed"
                    Grid.RowSpan="10" Grid.ColumnSpan="10" 
                    Height="9000" Width="9000" Background="Transparent"
                    MouseLeftButtonDown="VisiblBtn_Click"/>
            <Grid x:Name="MenuPanel" Cursor="None" >                
                <Grid Margin="0 0 10 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Секции: -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Секция: Управление персоналом -->
                        <Button x:Name="VisiblEmployeesBtn" Content="👥 Управление персоналом" Grid.Column="0"
                                VerticalAlignment="Top" 
                                FontSize="22" 
                                FontWeight="Bold" 
                                Margin="15,15,0,0" 
                                Click="VisiblEmployeesBtn_Click"/>

                        <!-- Секция: Управление товарами -->
                        <Button x:Name="VisiblProductsBtn"  Content="📦 Управление товарами" Grid.Column="1"
                                VerticalAlignment="Top" 
                                FontSize="22" 
                                FontWeight="Bold" 
                                Margin="15,15,0,0" 
                                Click="VisiblProductsBtn_Click"/>

                        <!-- Секция: Управление заказами и продажами -->
                        <Button x:Name="VisiblSuppliesBtn" Content="📋 Управление заказами и продажами"  Grid.Column="2"
                                VerticalAlignment="Top" 
                                FontSize="22" 
                                FontWeight="Bold" 
                                Margin="15,15,0,0" 
                                Click="VisiblSuppliesBtn_Click"/>

                        <!-- Секция: Отчеты и настройки -->
                        <Button x:Name="VisiblReportsBtn" Content="📊 Отчеты и настройки" Grid.Column="3"
                                VerticalAlignment="Top" 
                                FontSize="22" 
                                FontWeight="Bold" 
                                Margin="15,15,0,0" 
                                Click="VisiblReportsBtn_Click"/>                        
                    </Grid>

                    <!--  Кнопки секций  -->
                    <Grid Grid.Row="1" Margin="5 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel x:Name="VisiblEmployeesWarp" Grid.Column="0" Visibility="Collapsed">
                            <Button Width="200" Height="50" Margin="10" Click="EmployeesBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Сотрудники" FontSize="24"/>
                                        <!--<TextBlock Text="Управление сотрудниками"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="RolesBtn" Width="200" Height="50" Margin="10" Click="RolesBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="🔐" FontSize="24" TextAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Роли" FontSize="24"/>
                                        <!--<TextBlock Text="Управление ролями"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <WrapPanel x:Name="VisiblProductsWarp" Grid.Column="1" Visibility="Collapsed">
                            <Button Width="200" Height="50" Margin="10" Click="ProductsBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="📦" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Товары" FontSize="24"/>
                                        <!--<TextBlock Text="Каталог товаров" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="CategoriesBtn" Width="200" Height="50" Margin="10" Click="CategoriesBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="📁" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Категории" FontSize="24"/>
                                        <!--<TextBlock Text="Категории товаров" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Width="200" Height="50" Margin="10" Click="SuppliersBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="🚚" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Поставщики" FontSize="24"/>
                                        <!--<TextBlock Text="Управление поставщиками" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <WrapPanel x:Name="VisiblSuppliesWarp" Grid.Column="2" Visibility="Collapsed">
                            <Button Width="200" Height="50" Margin="10" Click="SuppliesBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Поставки" FontSize="24"/>
                                        <!--<TextBlock Text="Управление заказами" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Width="200" Height="50" Margin="10" Click="SalesBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="💰" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Продажи" FontSize="24"/>
                                        <!--<TextBlock Text="Отчеты по продажам" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <WrapPanel x:Name="VisiblReportsWarp"  Grid.Column="3" Visibility="Collapsed">
                            <Button Width="200" Height="50" Margin="10" Click="ReportsBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="📊" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Отчеты" FontSize="24"/>
                                        <!--<TextBlock Text="Аналитика и отчеты" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Width="200" Height="50" Margin="10" Click="SettingsBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Настройки" FontSize="24"/>
                                        <!--<TextBlock Text="Системные настройки" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Width="200" Height="50" Margin="10" Click="CalendarBtn_Click">
                                <StackPanel Orientation="Horizontal" Width="200">
                                    <TextBlock Text="📅" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Календарь" FontSize="24"/>
                                        <!--<TextBlock Text="Планирование" FontSize="10"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>


                </Grid>                
            </Grid>
        </Grid>
        
        
        <Grid Grid.Row="2" Background="#2196F3">
            <Grid x:Name="ButtomGrid" Visibility="Visible">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>


                <!--  Кнопка назад  -->
                <Button x:Name="BtnBack"
                    Grid.Column="0"
                    Content="← Назад"
                    Width="120"
                    Height="40"
                    Margin="10,5,0,5"
                    Visibility="Visible"
                    Click="BtnBack_Click"/>

                <!--  Пользователь  -->
                <Grid Grid.Column="2" Height="50" VerticalAlignment="Top" Cursor="Arrow" Grid.Row="2" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CurrentUser" Content="Фимилия И.О." Grid.Column="0" 
                            Click="CurrentUser_Click" Cursor="Hand"/>
                    <Image x:Name="EmployeeImage" Cursor="Arrow" Source="/Photos/istockavatar.png" Grid.Column="1">
                        <Image.Clip>
                            <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                        </Image.Clip>
                    </Image>
                </Grid>

            </Grid>
        </Grid>

        
    </Grid>
    
</Window>
