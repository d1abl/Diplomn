<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BaseTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Style 2 resources -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#282828" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="Violet" />
    <SolidColorBrush x:Key="BorderBrush" Color="#45475A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#89B4FA" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F38BA8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#A6E3A1" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#6C7086" />
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#585B70" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#6C7086" />
    <SolidColorBrush x:Key="ScrollBarThumbPressed" Color="#89B4FA" />
</ResourceDictionary>