<Window x:Class="Diplomn.AddSupplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый Поставка" Height="550" Width="750"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Оформление Поставки" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Выберите товар:" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbProduct" Height="35" Margin="0,0,0,5"
                          DisplayMemberPath="Наименование" SelectedValuePath="Код_товара"/>

                <TextBlock Text="Количество:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtQuantity" Text="1" Height="30" Margin="0,0,0,5"/>

                <TextBlock Text="Цена закупки:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtPrice" Height="30" Margin="0,0,0,5" IsReadOnly="True"/>

                <TextBlock Text="Выберите поставщика:" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbSupplier" Height="35" Margin="0,0,0,10"
                          DisplayMemberPath="Наименование_поставщика" SelectedValuePath="Код_поставщика"/>

                <Button Content="➕ Добавить в Поставка" Click="AddToOrder_Click"/>
            </StackPanel>

            <DataGrid x:Name="DataGridOrderItems" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Товары.Наименование}" Width="150"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} ₽}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}" Width="80"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Поставщики.Наименование_поставщика}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="TxtTotal"/>
            <Button Grid.Column="3" Content="Оформить Поставка" Click="SaveOrder_Click"/>
            <Button Grid.Column="4" Content="Отмена" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>