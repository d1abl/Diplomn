<Window x:Class="Diplomn.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="450" Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация о товаре" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Наименование:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Наименование, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Цена продажи:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Цена_за_ед_продажа, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Категория:" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbCategory" Height="30" Margin="0,0,0,10"
                      DisplayMemberPath="Категория" SelectedValuePath="Код_категория"
                      SelectedValue="{Binding Код_категория}"/>

            <TextBlock Text="Количество:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Количество, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Click="Save_Click"/>
            <Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>